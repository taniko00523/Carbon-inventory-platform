@{
    // 原本沒有對應的 Manage/_ViewStart.cshtml，這個共用版面從未真正被套用，
    // 導致「公司資訊/報告資料/密碼修改」側邊導覽選單永遠不會出現；
    // 現在 Manage/_ViewStart.cshtml 會指定套用此版面。
    // 而且原本 fallback 的 "/Areas/Identity/Pages/_Layout.cshtml" 根本不存在，
    // 一旦真的被套用就會丟例外變成 500，改成套用網站真正的共用版面。
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout !=  null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Views/Shared/_Layout.cshtml";
    }
}

<h1>資料維護</h1>

<div>
    @* <h2>Change your account settings</h2> *@
    <hr />
    <div class="row">
        <div class="col-md-3">
            <partial name="_ManageNav" />
        </div>
        <div class="col-md-9">
            @RenderBody()
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
