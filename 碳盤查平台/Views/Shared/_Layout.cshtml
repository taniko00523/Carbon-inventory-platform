<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 碳盤查平台</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/碳盤查平台.styles.css" asp-append-version="true" />
    <style>
        #B ul {
            text-align:right;
            float:left;
        }
    </style>
</head>
<body>
    <header>
        <div>
            <img src="https://www.stust.edu.tw/tc/images/about/logo.png"></img>
        </div>
        <div id="B">
            <ul>
                <li>
                    <a>主頁</a>
                </li>
                <li>
                    <a>客戶資料維護</a>
                </li>
                <li>
                    <a>廠區資料維護</a>
                </li>
                <li>
                    <a>設備資料維護</a>
                </li>
                <li>
                    <a>報告書下載</a>
                </li>
            </ul>
        </div>
        
    </header>
    
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2023 - 碳盤查平台 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
