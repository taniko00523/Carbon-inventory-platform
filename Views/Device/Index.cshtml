@model IEnumerable<Carbon_inventory_platform.Models.Device>

<h1>Device List</h1>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>AssetNo</th>
            <th>Name</th>
            <th>Provess</th>
            <!-- Add more table headers for other properties -->
        </tr>
    </thead>
    <tbody>
        @foreach (var device in Model)
        {
            <tr>
                <td>@device.Id</td>
                <td>@device.AssetNo</td>
                <td>@device.Name</td>
                <td>@device.Provess</td>
                <!-- Add more table cells for other properties -->
            </tr>
        }
    </tbody>
</table>
