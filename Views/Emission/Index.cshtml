            <td>
                @Model.Scope1_NF3.ToString("N4")
            </td>
            <td>
                @Model.Scope1.ToString("N4")
            </td>
        </tr>
        <tr>
            <td>
                @Model.percentage1_CO2.ToString("N2")%
