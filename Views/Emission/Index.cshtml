@model Carbon_inventory_platform.Models.Area

@{
    ViewBag.Title = "總碳排放量";
}

<h1>@ViewBag.Title</h1>
<h3>@TempData.Peek("companyName")</h3>
<p>
    @if(Model.Company.ModifiedTime!=null && Model.ModifiedTime!=null && Model.All!=0)
    {
        <a class="btn btn-warning" asp-controller="Emission" asp-action="Word3" asp-route-id="@TempData.Peek("areaId")">報告書下載</a>
    }
    else
    {
        <a class="btn btn-warning disabled" asp-controller="Emission" asp-action="Word3" asp-route-id="@TempData.Peek("areaId")">報告書下載</a>
    }
    <a class="btn btn-secondary" asp-controller="Devices" asp-action="Index" asp-route-id="@TempData.Peek("areaId")">返回</a>
</p>
<h3>類別一七大溫室氣體排放量統計表</h3>
<table class="table">
    <thead>
        <tr>
            <th>
                CO₂
            </th>
            <th>
                CH₄
            </th>
            <th>
                N₂O
            </th>
            <th>
                HFCₛ
            </th>
            <th>
                PFCₛ
            </th>
            <th>
                SF₆
            </th>
            <th>
                NF₃
            </th>
            <th>
                總計
            </th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>
                @Model.Scope1_CO2.ToString("N4")
            </td>
            <td>
                @Model.Scope1_CH4.ToString("N4")
            </td>
            <td>
                @Model.Scope1_N2O.ToString("N4")
            </td>
            <td>
                @Model.Scope1_HFCS.ToString("N4")
