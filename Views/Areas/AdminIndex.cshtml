                                                    <td>盤查服務運送所產生之排放</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._32A, aListItem, new { @class = "form-control" })</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._32B, aListItem, new { @class = "form-control" })</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._32C, aListItem, new { @class = "form-control" })</td>
