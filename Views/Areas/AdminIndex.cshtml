                                                    <td>@Html.DropDownListFor(model => item.Analysis._43A, aListItem, new { @class = "form-control" })</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._43B, aListItem, new { @class = "form-control" })</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._43C, aListItem, new { @class = "form-control" })</td>
                                                    <td></td>
                                                    <td></td>
                                                </tr>
                                                <tr>
                                                    <td>4.4商品_資源</td>
                                                    <td>自來水等</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._44A, aListItem, new { @class = "form-control" })</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._44B, aListItem, new { @class = "form-control" })</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._44C, aListItem, new { @class = "form-control" })</td>
                                                    <td></td>
                                                    <td></td>
                                                </tr>
                                                <tr>
