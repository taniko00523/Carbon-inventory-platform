                                                    <td>@Html.DropDownListFor(model => item.Analysis._33B, aListItem, new { @class = "form-control" })</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._33C, aListItem, new { @class = "form-control" })</td>
