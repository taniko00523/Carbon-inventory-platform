                                            <thead>
                                                <tr>
                                                    <th>類別</th>
                                                    <th>間接排放活動項目</th>
                                                    <th>活動資料品質(A)</th>
                                                    <th>係數品質(B)</th>
                                                    <th>發生/使用頻率(C)</th>
                                                    <th>重大性(A*B)*C</th>
                                                    <th>量化與否</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td>2.1輸入電力</td>
                                                    <td>輸入電力所產生之排放</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._21A, aListItem, new { @class = "form-control" })</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._21B, aListItem, new { @class = "form-control" })</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._21C, aListItem, new { @class = "form-control" })</td>
                                                    <td></td>
                                                    <td></td>
                                                </tr>
                                                <tr>
                                                    <td>2.2輸入二次能源</td>
                                                    <td>無</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._22A, aListItem, new { @class = "form-control" })</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._22B, aListItem, new { @class = "form-control" })</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._22C, aListItem, new { @class = "form-control" })</td>
                                                    <td></td>
                                                    <td></td>
                                                </tr>

                                                <tr>
                                                    <td>3.1上游運輸和配送貨物</td>
                                                    <td>盤查年度原物料及服務運送所產生之排放</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._31A, aListItem, new { @class = "form-control" })</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._31B, aListItem, new { @class = "form-control" })</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._31C, aListItem, new { @class = "form-control" })</td>
                                                    <td></td>
                                                    <td></td>
                                                </tr>
                                                <tr>
