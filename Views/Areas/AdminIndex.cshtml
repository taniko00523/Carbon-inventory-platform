                                                    <td>@Html.DropDownListFor(model => item.Analysis._34B, aListItem, new { @class = "form-control" })</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._34C, aListItem, new { @class = "form-control" })</td>
