                                                    <td>@Html.DropDownListFor(model => item.Analysis._410A, aListItem, new { @class = "form-control" })</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._410B, aListItem, new { @class = "form-control" })</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._410C, aListItem, new { @class = "form-control" })</td>
                                                    <td></td>
                                                    <td></td>
                                                </tr>
                                                <tr>
                                                    <td>4.11服務_其他</td>
                                                    <td>無</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._411A, aListItem, new { @class = "form-control" })</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._411B, aListItem, new { @class = "form-control" })</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._411C, aListItem, new { @class = "form-control" })</td>
                                                    <td></td>
                                                    <td></td>
                                                </tr>

                                                <tr>
                                                    <td>5.1產品加工</td>
