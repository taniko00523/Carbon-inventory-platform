                                                    <td>@Html.DropDownListFor(model => item.Analysis._51A, aListItem, new { @class = "form-control" })</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._51B, aListItem, new { @class = "form-control" })</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._51C, aListItem, new { @class = "form-control" })</td>
                                                    <td></td>
                                                    <td></td>
                                                </tr>
                                                <tr>
