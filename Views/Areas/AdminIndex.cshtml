                                                    <td>@Html.DropDownListFor(model => item.Analysis._35B, aListItem, new { @class = "form-control" })</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._35C, aListItem, new { @class = "form-control" })</td>
                                                    <td></td>
                                                    <td></td>
                                                </tr>

                                                <tr>
                                                    <td>4.1商品_輸入電力</td>
