                                                    <td>原物料(防鏽油、脫脂劑、黑化劑、酸液、磷化劑)等</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._45A, aListItem, new { @class = "form-control" })</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._45B, aListItem, new { @class = "form-control" })</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._45C, aListItem, new { @class = "form-control" })</td>
                                                    <td></td>
                                                    <td></td>
                                                </tr>
                                                <tr>
                                                    <td>4.6商品_輔助原料</td>
                                                    <td>片鹼、液鹼、助凝劑、雙氧水、脫氧劑、設備維護保養原料等</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._46A, aListItem, new { @class = "form-control" })</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._46B, aListItem, new { @class = "form-control" })</td>
                                                    <td>@Html.DropDownListFor(model => item.Analysis._46C, aListItem, new { @class = "form-control" })</td>
                                                    <td></td>
                                                    <td></td>
                                                </tr>
                                                <tr>
