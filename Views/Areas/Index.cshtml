@model IEnumerable<Carbon_inventory_platform.Models.Area>
@{
    ViewData["Title"] = "邊界總覽";
}
<div class="row">
    <div class="col">
        <h1>@ViewData["Title"]</h1>
        <h3>@TempData.Peek("companyName")</h3>
        <a class="btn btn-primary" asp-action="Create" asp-route-id=@TempData.Peek("selectedCompanyId")>新增</a>
        @if (User.IsInRole("Admin"))
        {
            <a class="btn btn-secondary" asp-controller="Companies" asp-action="Index">返回</a>
        }
    </div>
</div>

<div class="table-computer-w1024">
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Year)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Name)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.UniqueCode)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FactorCode)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FullAddress)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.BaseYear)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Type)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.OrganizationImage)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.MapImage)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ShopDrawings)
                </th>
                <th></th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Year)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.UniqueCode)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.FactorCode)
                    </td>
                    <td style="width:10%">
                        @Html.DisplayFor(modelItem => item.FullAddress)
                    </td>
                    <td>
                        @if (item.BaseYear == true)
                        {
                            <p>V</p>
                        }
                        else
                        {

                        }
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Type)
                    </td>
                    <th>
                        @if (item.OrganizationImagePath != "" && item.OrganizationImagePath != null)
                        {
                            <img src="@item.OrganizationImagePath" width="40" height="40" onclick="window.open('@item.OrganizationImagePath', '_blank')"></img>
                        }
                        else
                        {
                            <p>未上傳</p>
                        }
                    </th>
                    <th>
                        @if (item.MapImagePath != "" && item.MapImagePath != null)
                        {
                            <img src="@item.MapImagePath" width="40" height="40" onclick="window.open('@item.MapImagePath', '_blank')"></img>
                        }
                        else
                        {
                            <p>未上傳</p>
                        }
                    </th>
                    <th>
                        @if (item.ShopDrawingsPath != "" && item.ShopDrawingsPath != null)
                        {
                            <img src="@item.ShopDrawingsPath" width="40" height="40" onclick="window.open('@item.ShopDrawingsPath', '_blank')"></img>

                        }
                        else
                        {
                            <p>未上傳</p>
                        }
                    </th>
                    <td>
                        <a class="btn btn-primary" asp-action="CopyArea" asp-route-id="@item.Id">複製</a>
                        @if (item.Name != "")
                        {
                            <a class="btn btn-success" asp-action="Edit" asp-route-id="@item.Id">修改</a>
                        }
                        else
                        {
                            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.Id">填寫</a>
                        }
                        <a class="btn btn-info" asp-controller="Areas" asp-action="Analyses" asp-route-id="@item.Id">重大性評估</a>
                        <a class="btn btn-info" asp-controller="Devices" asp-action="Index" asp-route-id="@item.Id">排放源資料</a>
                    </td>
                    <td>
                        <form method="post" asp-action="Delete" asp-route-id="@item.Id" onsubmit="return confirm('確定要刪除嗎？');">
                            <button type="submit" class="btn btn-danger">刪除</button>
                        </form>
                    </td>
                </tr>

            }
        </tbody>
    </table>

</div>
<div class="table-phone-w1024">
    <div class="card-columns">
        @foreach (var item in Model)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">@Html.DisplayFor(modelItem => item.Name)</h5>
                    <p class="card-text"><strong>@Html.DisplayNameFor(model => model.Year):</strong> @Html.DisplayFor(modelItem => item.Year)</p>
                    <p class="card-text"><strong>@Html.DisplayNameFor(model => model.UniqueCode):</strong> @Html.DisplayFor(modelItem => item.UniqueCode)</p>
                    <p class="card-text"><strong>@Html.DisplayNameFor(model => model.FactorCode):</strong> @Html.DisplayFor(modelItem => item.FactorCode)</p>
                    <p class="card-text"><strong>@Html.DisplayNameFor(model => model.FullAddress):</strong> @Html.DisplayFor(modelItem => item.FullAddress)</p>
                    <p class="card-text"><strong>@Html.DisplayNameFor(model => model.BaseYear):</strong> @(item.BaseYear ? "V" : "")</p>
                    <p class="card-text"><strong>@Html.DisplayNameFor(model => model.Type):</strong> @Html.DisplayFor(modelItem => item.Type)</p>

                    <p class="card-text">
                        <strong>@Html.DisplayNameFor(model => model.OrganizationImage):</strong>
                        @if (!string.IsNullOrEmpty(item.OrganizationImagePath))
                        {
                            <img src="@item.OrganizationImagePath" width="40" height="40" onclick="window.open('@item.OrganizationImagePath', '_blank')" />
                        }
                        else
                        {
                        <p>未上傳</p>
                        }
                    </p>
                    <p class="card-text">
                        <strong>@Html.DisplayNameFor(model => model.MapImage):</strong>
                        @if (!string.IsNullOrEmpty(item.MapImagePath))
                        {
                            <img src="@item.MapImagePath" width="40" height="40" onclick="window.open('@item.MapImagePath', '_blank')" />
                        }
                        else
                        {
                        <p>未上傳</p>
                        }
                    </p>
                    <p class="card-text">
                        <strong>@Html.DisplayNameFor(model => model.ShopDrawings):</strong>
                        @if (!string.IsNullOrEmpty(item.ShopDrawingsPath))
                        {
                            <img src="@item.ShopDrawingsPath" width="40" height="40" onclick="window.open('@item.ShopDrawingsPath', '_blank')" />
                        }
                        else
                        {
                        <p>未上傳</p>
                        }
                    </p>
                    <div class="btn-group" role="group">
                        <a class="btn btn-primary" asp-action="CopyArea" asp-route-id="@item.Id">複製</a>
                        @if (!string.IsNullOrEmpty(item.Name))
                        {
                            <a class="btn btn-success" asp-action="Edit" asp-route-id="@item.Id">修改</a>
                        }
                        else
                        {
                            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.Id">填寫</a>
                        }
                        <a class="btn btn-info" asp-controller="Areas" asp-action="Analyses" asp-route-id="@item.Id">重大性評估</a>
                        <a class="btn btn-info" asp-controller="Devices" asp-action="Index" asp-route-id="@item.Id">排放源資料</a>
                    </div>
                    <form method="post" asp-action="Delete" asp-route-id="@item.Id" onsubmit="return confirm('確定要刪除嗎？');" class="d-inline">
                        <button type="submit" class="btn btn-danger">刪除</button>
                    </form>
                </div>
            </div>
        }
    </div>

</div>