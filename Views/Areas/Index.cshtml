@model IEnumerable<Carbon_inventory_platform.Models.Area>
@{
    ViewData["Title"] = "邊界總覽";
}
<div class="cip-page-head">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p class="cip-page-sub">@TempData.Peek("companyName")</p>
    </div>
    <div class="cip-page-actions">
        <a class="btn btn-primary" asp-action="Create" asp-route-id="@TempData.Peek("selectedCompanyId")">新增</a>
        @if (User.IsInRole("Admin"))
        {
            <a class="btn btn-outline-secondary" asp-controller="Companies" asp-action="Index">返回</a>
        }
    </div>
</div>

@if (!Model.Any())
{
    <div class="cip-empty cip-section">
        <div class="cip-empty-icon" aria-hidden="true">🏭</div>
        <p class="cip-empty-title">尚未建立任何盤查邊界</p>
        <p>先新增一筆廠區資料，才能開始登記排放源。</p>
        <a class="btn btn-primary" asp-action="Create" asp-route-id="@TempData.Peek("selectedCompanyId")">新增邊界資料</a>
    </div>
}
else
{
    <div class="table-computer-w1024 cip-table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Year)</th>
                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                    <th>@Html.DisplayNameFor(model => model.UniqueCode)</th>
                    <th>@Html.DisplayNameFor(model => model.FactorCode)</th>
                    <th>@Html.DisplayNameFor(model => model.FullAddress)</th>
                    <th>@Html.DisplayNameFor(model => model.BaseYear)</th>
                    <th>@Html.DisplayNameFor(model => model.Type)</th>
                    <th>圖片</th>
                    <th>重大性評估</th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="cip-num">@Html.DisplayFor(modelItem => item.Year)</td>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.UniqueCode)</td>
                        <td>@Html.DisplayFor(modelItem => item.FactorCode)</td>
                        <td>@Html.DisplayFor(modelItem => item.FullAddress)</td>
                        <td>
                            @if (item.BaseYear)
                            {
                                <span class="cip-badge cip-badge-success">基準年</span>
                            }
                            @if (item.IsLocked)
                            {
                                <span class="cip-badge cip-badge-warning" title="鎖定時間：@item.LockedAt?.ToString("yyyy-MM-dd HH:mm")　鎖定者：@item.LockedByUserName">已鎖定</span>
                            }
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.Type)</td>
                        <td>
                            @* 原本三張圖各佔一欄、40x40 裸 <img> 沒有 alt、沒有樣式，改成統一縮圖樣式集中一欄。 *@
                            <div class="cip-badge-row">
                                @if (!string.IsNullOrEmpty(item.OrganizationImagePath))
                                {
                                    <img src="@item.OrganizationImagePath" class="cip-thumb" alt="組織架構圖" title="組織架構圖" onclick="window.open('@item.OrganizationImagePath', '_blank')" />
                                }
                                else
                                {
                                    <span class="cip-thumb-empty" title="組織架構圖尚未上傳">組織</span>
                                }
                                @if (!string.IsNullOrEmpty(item.MapImagePath))
                                {
                                    <img src="@item.MapImagePath" class="cip-thumb" alt="地理位置圖" title="地理位置圖" onclick="window.open('@item.MapImagePath', '_blank')" />
                                }
                                else
                                {
                                    <span class="cip-thumb-empty" title="地理位置圖尚未上傳">位置</span>
                                }
                                @if (!string.IsNullOrEmpty(item.ShopDrawingsPath))
                                {
                                    <img src="@item.ShopDrawingsPath" class="cip-thumb" alt="廠區配置圖" title="廠區配置圖" onclick="window.open('@item.ShopDrawingsPath', '_blank')" />
                                }
                                else
                                {
                                    <span class="cip-thumb-empty" title="廠區配置圖尚未上傳">配置</span>
                                }
                            </div>
                        </td>
                        <td>
                            @if (!item.IsLocked)
                            {
                                <a class="btn btn-sm btn-info" asp-controller="Areas" asp-action="Analyses" asp-route-id="@item.Id">設定</a>
                            }
                        </td>
                        <td class="cip-table-actions">
                            @if (!item.IsLocked)
                            {
                                <form method="post" asp-action="CopyArea" asp-route-id="@item.Id" onsubmit="return confirm('確定要複製這個廠區嗎？');" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-primary">複製</button>
                                </form>
                                @if (item.Name != "")
                                {
                                    <a class="btn btn-sm btn-success" asp-action="Edit" asp-route-id="@item.Id">修改</a>
                                }
                                else
                                {
                                    <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.Id">填寫</a>
                                }
                            }
                            <a class="btn btn-sm btn-info" asp-controller="Devices" asp-action="Index" asp-route-id="@item.Id">排放源資料</a>
                            <a class="btn btn-sm btn-outline-info" asp-controller="Emission" asp-action="Trend" asp-route-id="@item.Id">歷年趨勢</a>
                            @if (!item.IsLocked)
                            {
                                <form method="post" asp-action="Lock" asp-route-id="@item.Id" onsubmit="return confirm('鎖定後這個廠區的資料就不能再修改，只有管理員能解鎖，確定要鎖定嗎？');" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-warning">鎖定</button>
                                </form>
                            }
                            else if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                            {
                                <form method="post" asp-action="Unlock" asp-route-id="@item.Id" onsubmit="return confirm('確定要解鎖這個廠區嗎？');" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">解鎖</button>
                                </form>
                            }
                        </td>
                        <td>
                            @if (!item.IsLocked)
                            {
                                <form method="post" asp-action="Delete" asp-route-id="@item.Id" onsubmit="return confirm('確定要刪除嗎？');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">刪除</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="table-phone-w1024">
        <div class="card-columns">
            @foreach (var item in Model)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">@Html.DisplayFor(modelItem => item.Name)</h5>
                        <p class="card-text"><strong>@Html.DisplayNameFor(model => model.Year):</strong> @Html.DisplayFor(modelItem => item.Year)</p>
                        <p class="card-text"><strong>@Html.DisplayNameFor(model => model.UniqueCode):</strong> @Html.DisplayFor(modelItem => item.UniqueCode)</p>
                        <p class="card-text"><strong>@Html.DisplayNameFor(model => model.FactorCode):</strong> @Html.DisplayFor(modelItem => item.FactorCode)</p>
                        <p class="card-text"><strong>@Html.DisplayNameFor(model => model.FullAddress):</strong> @Html.DisplayFor(modelItem => item.FullAddress)</p>
                        <p class="card-text">
                            <strong>@Html.DisplayNameFor(model => model.BaseYear):</strong>
                            @if (item.BaseYear)
                            {
                                <span class="cip-badge cip-badge-success">基準年</span>
                            }
                            @if (item.IsLocked)
                            {
                                <span class="cip-badge cip-badge-warning">已鎖定</span>
                            }
                        </p>
                        <p class="card-text"><strong>@Html.DisplayNameFor(model => model.Type):</strong> @Html.DisplayFor(modelItem => item.Type)</p>

                        <p class="card-text">
                            <strong>圖片：</strong>
                            <span class="cip-badge-row" style="display:inline-flex">
                                @if (!string.IsNullOrEmpty(item.OrganizationImagePath))
                                {
                                    <img src="@item.OrganizationImagePath" class="cip-thumb" alt="組織架構圖" onclick="window.open('@item.OrganizationImagePath', '_blank')" />
                                }
                                @if (!string.IsNullOrEmpty(item.MapImagePath))
                                {
                                    <img src="@item.MapImagePath" class="cip-thumb" alt="地理位置圖" onclick="window.open('@item.MapImagePath', '_blank')" />
                                }
                                @if (!string.IsNullOrEmpty(item.ShopDrawingsPath))
                                {
                                    <img src="@item.ShopDrawingsPath" class="cip-thumb" alt="廠區配置圖" onclick="window.open('@item.ShopDrawingsPath', '_blank')" />
                                }
                            </span>
                        </p>
                        @if (!item.IsLocked)
                        {
                            <p class="card-text">
                                <strong>重大性評估:</strong>
                                <a class="btn btn-sm btn-info" asp-controller="Areas" asp-action="Analyses" asp-route-id="@item.Id">設定</a>
                            </p>
                        }
                        <div class="btn-group" role="group">
                            @if (!item.IsLocked)
                            {
                                <form method="post" asp-action="CopyArea" asp-route-id="@item.Id" onsubmit="return confirm('確定要複製這個廠區嗎？');" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-primary">複製</button>
                                </form>
                                @if (!string.IsNullOrEmpty(item.Name))
                                {
                                    <a class="btn btn-sm btn-success" asp-action="Edit" asp-route-id="@item.Id">修改</a>
                                }
                                else
                                {
                                    <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.Id">填寫</a>
                                }
                            }
                            <a class="btn btn-sm btn-info" asp-controller="Devices" asp-action="Index" asp-route-id="@item.Id">排放源資料</a>
                            <a class="btn btn-sm btn-outline-info" asp-controller="Emission" asp-action="Trend" asp-route-id="@item.Id">歷年趨勢</a>
                        </div>
                        @if (!item.IsLocked)
                        {
                            <form method="post" asp-action="Lock" asp-route-id="@item.Id" onsubmit="return confirm('鎖定後這個廠區的資料就不能再修改，只有管理員能解鎖，確定要鎖定嗎？');" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-warning">鎖定</button>
                            </form>
                            <form method="post" asp-action="Delete" asp-route-id="@item.Id" onsubmit="return confirm('確定要刪除嗎？');" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">刪除</button>
                            </form>
                        }
                        else if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                        {
                            <form method="post" asp-action="Unlock" asp-route-id="@item.Id" onsubmit="return confirm('確定要解鎖這個廠區嗎？');" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">解鎖</button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}
