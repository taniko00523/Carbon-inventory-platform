                    <td>@Html.DropDownListFor(model => Model._34A, aListItem, new { @class = "form-control" })</td>
                    <td>@Html.DropDownListFor(model => Model._34B, aListItem, new { @class = "form-control" })</td>
                    <td>@Html.DropDownListFor(model => Model._34C, aListItem, new { @class = "form-control" })</td>
