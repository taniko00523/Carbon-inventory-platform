                    <th width="200">發生頻率(B)</th>
                    <th width="200">使用量大小(C)</th>
                    <th width="200">影響程度(D)</th>
                    <th width="100">重大性(A+B+C+D)</th>
                    <th width="100">量化與否</th>
                </tr>
            </thead>
            <tbody class="table-secondary">
