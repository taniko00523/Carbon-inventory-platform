                    <td>@Html.DropDownListFor(model => Model._35A, aListItem, new { @class = "form-control" })</td>
                    <td>@Html.DropDownListFor(model => Model._35B, aListItem, new { @class = "form-control" })</td>
                    <td>@Html.DropDownListFor(model => Model._35C, aListItem, new { @class = "form-control" })</td>
