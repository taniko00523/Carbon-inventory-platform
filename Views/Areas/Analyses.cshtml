                    <td>@Html.DropDownListFor(model => Model._47C, aListItem, new { @class = "form-control" })</td>
                    <td></td>
                    <td></td>
                </tr>
                <tr>
                    <td>4.8服務_不可回收廢棄物</td>
                    <td>營運產生之不可回收廢棄物處理：生活垃圾(焚化)、汙泥</td>
                    <td>@Html.DropDownListFor(model => Model._48A, aListItem, new { @class = "form-control" })</td>
