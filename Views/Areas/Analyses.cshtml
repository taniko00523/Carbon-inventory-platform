@model Carbon_inventory_platform.Models.Analysis
@{
    ViewData["Title"] = "重大性評估";
    List<SelectListItem> aListItem = new List<SelectListItem>
{
    new SelectListItem { Value = "1", Text = "連續監測數據" },
    new SelectListItem { Value = "2", Text = "間接量測" },
    new SelectListItem { Value = "3", Text = "自行評估/沒有相關資訊無法推估" }
};
    List<SelectListItem> bListItem = new List<SelectListItem>
{
    new SelectListItem { Value = "1", Text = "國際排放係數/無依據" },
    new SelectListItem { Value = "2", Text = "國家排放係數" },
    new SelectListItem { Value = "3", Text = "自廠發展係數/質量平衡所得係數/同製程/設備經驗係數/製造廠提供係數/區域排放係數" }
};
    List<SelectListItem> cListItem = new List<SelectListItem>
{
    new SelectListItem { Value = "1", Text = "每季不到一次" },
    new SelectListItem { Value = "2", Text = "每周 /月一次" },
    new SelectListItem { Value = "3", Text = "每天一次" }
};
}


<form method="post" asp-action="Analyses">
    <div class="modal-body">
        <input type="hidden" asp-for="Id" value="@Model.Id" />
        <table class="table">
            <thead>
                <tr>
                    <th>類別</th>
                    <th>間接排放活動項目</th>
                    <th>活動資料品質(A)</th>
                    <th>係數品質(B)</th>
                    <th>發生/使用頻率(C)</th>
                    <th>重大性(A*B)*C</th>
                    <th>量化與否</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>2.1輸入電力</td>
                    <td>輸入電力所產生之排放</td>
                    <td>@Html.DropDownListFor(model => Model._21A, aListItem, new { @class = "form-control", @onchange = "CountAnalyses();" })</td>
                    <td>@Html.DropDownListFor(model => Model._21B, aListItem, new { @class = "form-control" })</td>
                    <td>@Html.DropDownListFor(model => Model._21C, aListItem, new { @class = "form-control" })</td>
                    <td></td>
                    <td></td>
                </tr>
                <tr>
                    <td>2.2輸入二次能源</td>
                    <td>無</td>
                    <td>@Html.DropDownListFor(model => Model._22A, aListItem, new { @class = "form-control" })</td>
                    <td>@Html.DropDownListFor(model => Model._22B, aListItem, new { @class = "form-control" })</td>
                    <td>@Html.DropDownListFor(model => Model._22C, aListItem, new { @class = "form-control" })</td>
                    <td></td>
                    <td></td>
                </tr>

                <tr>
                    <td>3.1上游運輸和配送貨物</td>
                    <td>盤查年度原物料及服務運送所產生之排放</td>
                    <td>@Html.DropDownListFor(model => Model._31A, aListItem, new { @class = "form-control" })</td>
                    <td>@Html.DropDownListFor(model => Model._31B, aListItem, new { @class = "form-control" })</td>
                    <td>@Html.DropDownListFor(model => Model._31C, aListItem, new { @class = "form-control" })</td>
                    <td></td>
                    <td></td>
                </tr>
                <tr>
                    <td>3.2下游運輸和配送貨物</td>
                    <td>盤查服務運送所產生之排放</td>
                    <td>@Html.DropDownListFor(model => Model._32A, aListItem, new { @class = "form-control" })</td>
                    <td>@Html.DropDownListFor(model => Model._32B, aListItem, new { @class = "form-control" })</td>
                    <td>@Html.DropDownListFor(model => Model._32C, aListItem, new { @class = "form-control" })</td>
                    <td></td>
                    <td></td>
                </tr>
                <tr>
                    <td>3.3員工通勤</td>
