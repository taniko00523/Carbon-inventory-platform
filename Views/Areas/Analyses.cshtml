                    <td>@Html.DropDownListFor(model => Model._33B, aListItem, new { @class = "form-control" })</td>
                    <td>@Html.DropDownListFor(model => Model._33C, aListItem, new { @class = "form-control" })</td>
                    <td></td>
                    <td></td>
                </tr>
                <tr>
