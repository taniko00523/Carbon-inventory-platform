                    <td>6.1維修與施工</td>
                    <td>承攬維修與施工</td>
                    <td>@Html.DropDownListFor(model => Model._61A, aListItem, new { @class = "form-control", @onchange = "CountAnalyses('61');" })</td>
                    <td>@Html.DropDownListFor(model => Model._61B, bListItem, new { @class = "form-control", @onchange = "CountAnalyses('61');" })</td>
                    <td>@Html.DropDownListFor(model => Model._61C, cListItem, new { @class = "form-control", @onchange = "CountAnalyses('61');" })</td>
                    <td>@Html.EditorFor(model => Model._61, new { @class = "form-control" })</td>
                    <td>@Html.DropDownListFor(model => Model._61isCal, isCalListItem, new { @class = "form-control", @style = Model._61isCal == 1 ? "color: red; font-weight: bold;" : "" })</td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="modal-footer">
        <input type="submit" value="儲存" class="btn btn-primary" />
    </div>

</form>
@section scripts
{
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        function CountAnalyses(scope) {
            var A = parseInt(document.getElementById('z' + scope + 'A').value, 10);
            var B = parseInt(document.getElementById('z' + scope + 'B').value, 10);
            var C = parseInt(document.getElementById('z' + scope + 'C').value, 10);

            var total = A * B * C;
            document.getElementById('z' + scope).value = total;
            if (total > 8) {
                document.getElementById('z' + scope + 'isCal').value = 1;
                document.getElementById('z' + scope + 'isCal').style.color = 'red';
                document.getElementById('z' + scope + 'isCal').style.fontWeight = 'bold';
            } else {
                document.getElementById('z' + scope + 'isCal').value = 0;
                document.getElementById('z' + scope + 'isCal').style.color = 'black';
                document.getElementById('z' + scope + 'isCal').style.fontWeight = 'normal';
            }
        }

    </script>
}
