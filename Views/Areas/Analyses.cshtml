                    <th width="250">間接排放活動項目</th>
                    <th width="200">活動資料品質(A)</th>
                    <th width="200">係數品質(B)</th>
                    <th width="200">發生/使用頻率(C)</th>
                    <th width="100">重大性(A*B)*C</th>
                    <th width="100">量化與否</th>
                </tr>
            </thead>
            <tbody class="table-secondary">
                <tr>
                    <td>2.1輸入電力</td>
                    <td>輸入電力所產生之排放</td>
                    <td>@Html.DropDownListFor(model => Model._21A, aListItem, new { @class = "form-control", @onchange = "CountAnalyses('21');" })</td>
                    <td>@Html.DropDownListFor(model => Model._21B, bListItem, new { @class = "form-control", @onchange = "CountAnalyses('21');" })</td>
                    <td>@Html.DropDownListFor(model => Model._21C, cListItem, new { @class = "form-control", @onchange = "CountAnalyses('21');" })</td>
                    <td>@Html.EditorFor(model => Model._21, new { @class = "form-control" })</td>
                    <td>@Html.DropDownListFor(model => model._21isCal, isCalListItem, new { @class = "form-control", @style = Model._21isCal == 1 ? "color: red; font-weight: bold;" : "" })</td>
                </tr>
                <tr>
                    <td>2.2輸入二次能源</td>
