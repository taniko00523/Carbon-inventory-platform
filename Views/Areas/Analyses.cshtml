                    <th width="200">發生頻率(B)</th>
                    <th width="200">使用量大小(C)</th>
                    <th width="200">影響程度(D)</th>
                    <th width="100">重大性(A+B+C+D)</th>
                    <th width="100">量化與否</th>
                </tr>
            </thead>
            <tbody class="table-secondary">
                <tr>
                    <td>2.1輸入電力</td>
                    <td>@Html.EditorFor(model => Model._21Remark, new { @class = "form-control" })</td>
                    <td>@Html.DropDownListFor(model => Model._21A, aListItem, new { @class = "form-control", @onchange = "CountAnalyses('21');" })</td>
                    <td>@Html.DropDownListFor(model => Model._21B, bListItem, new { @class = "form-control", @onchange = "CountAnalyses('21');" })</td>
