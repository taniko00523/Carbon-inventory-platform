@section scripts
{
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // 原本 asp-for 的 lambda 寫成 model => Model._21A（大寫 Model，關到外層 Model 屬性，沒用到參數 model），
        // 會導致 Razor 產生的 name/id 不是預期的 "_21A"，這裡的 JS 又用 "z21A" 去找元素，兩邊對不起來，
        // 造成總分與量化與否從未即時更新。已將上面的 lambda 改回 model => model._21A，這裡改成對應的 "_" 前綴。
        function CountAnalyses(scope) {
            var A = parseInt(document.getElementById('_' + scope + 'A').value, 10);
            var B = parseInt(document.getElementById('_' + scope + 'B').value, 10);
            var C = parseInt(document.getElementById('_' + scope + 'C').value, 10);
            var D = parseInt(document.getElementById('_' + scope + 'D').value, 10);

            var total = A + B + C + D;
            document.getElementById('_' + scope).value = total;
            document.getElementById('lb' + scope).innerText = total;
            if (total > 10) {
                document.getElementById('_' + scope + 'isCal').value = 1;
                document.getElementById('_' + scope + 'isCal').style.color = 'red';
                document.getElementById('_' + scope + 'isCal').style.fontWeight = 'bold';
            } else {
                document.getElementById('_' + scope + 'isCal').value = 0;
                document.getElementById('_' + scope + 'isCal').style.color = 'black';
                document.getElementById('_' + scope + 'isCal').style.fontWeight = 'normal';
            }
        }


    </script>
}
