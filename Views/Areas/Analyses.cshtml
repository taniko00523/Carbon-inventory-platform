@model Carbon_inventory_platform.Models.Analysis
@{
    ViewData["Title"] = "重大性評估";
    List<SelectListItem> aListItem = new List<SelectListItem>
{
    new SelectListItem { Value = "0", Text = "無" },
    new SelectListItem { Value = "1", Text = "自行評估/沒有相關資訊無法推估" },
    new SelectListItem { Value = "2", Text = "間接量測" },
    new SelectListItem { Value = "3", Text = "連續監測數據" }
};
    List<SelectListItem> bListItem = new List<SelectListItem>
{
        new SelectListItem { Value = "0", Text = "無" },
    new SelectListItem { Value = "1", Text = "國際排放係數/無依據" },
    new SelectListItem { Value = "2", Text = "國家排放係數" },
    new SelectListItem { Value = "3", Text = "自廠發展係數/質量平衡所得係數/同製程/設備經驗係數/製造廠提供係數/區域排放係數" }
};
    List<SelectListItem> cListItem = new List<SelectListItem>
{
        new SelectListItem { Value = "0", Text = "無" },
    new SelectListItem { Value = "1", Text = "每季不到一次" },
    new SelectListItem { Value = "2", Text = "每周 /月一次" },
    new SelectListItem { Value = "3", Text = "每天一次" }
};
    List<SelectListItem> isCalListItem = new List<SelectListItem>
{
    new SelectListItem { Value = "0", Text = "否" },
    new SelectListItem { Value = "1", Text = "是" }
};
}

<h1>@ViewData["Title"] </h1>
