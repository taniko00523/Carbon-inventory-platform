                    <td>@Html.HiddenFor(model => model._21, new { @class = "form-control" })<label id="lb21">@Model._21</label></td>
                    <td>@Html.DropDownListFor(model => model._21isCal, isCalListItem, new { @class = "form-control", @style = Model._21isCal == 1 ? "color: red; font-weight: bold;" : "" })</td>
