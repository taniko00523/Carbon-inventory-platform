@model Carbon_inventory_platform.Models.Area

@{
    ViewData["Title"] = "邊界資料新增";
}

@* 原本表單塞進 col-md-4，且 City/District/Address 三個欄位用 style="display:none" 藏著卻還是會送出——
   Controller 的 [Bind] 清單根本沒有列這三個屬性，送了也沒用，直接移除。改成寬版兩欄排版，
   必填標記換成跟全站一致的 .cip-required，送出/返回按鈕不再用「|」分隔。 *@
<div class="cip-page-head">
    <div>
        <h1>@ViewData["Title"]</h1>
    </div>
    <div class="cip-page-actions">
        @if (User.IsInRole("Admin"))
        {
            <a class="btn btn-outline-secondary" asp-controller="Areas" asp-action="Index" asp-route-id="@TempData.Peek("companyId")">返回</a>
        }
        else
        {
            <a class="btn btn-outline-secondary" asp-controller="Areas" asp-action="Index">返回</a>
        }
    </div>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="text-danger"></div>

    <section class="cip-section">
        <h2 class="cip-section-title">基本資料</h2>
        <div class="cip-form-grid">
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" placeholder="若無請留空白" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Type" class="control-label"></label>
                <input asp-for="Type" placeholder="請填寫產業別，如：電子業、製造業" class="form-control" />
                <span asp-validation-for="Type" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="UniqueCode" class="control-label cip-required"></label>
                <input asp-for="UniqueCode" placeholder="請填寫統一編號" class="form-control" />
                <span asp-validation-for="UniqueCode" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FactorCode" class="control-label cip-required"></label>
                <input asp-for="FactorCode" placeholder="請填寫工廠登記編號" class="form-control" />
                <span asp-validation-for="FactorCode" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Year" class="control-label cip-required"></label>
                <input asp-for="Year" placeholder="請填寫民國盤查年度" class="form-control" />
                <span asp-validation-for="Year" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ARVersion" class="control-label cip-required"></label>
                <select asp-for="ARVersion" class="form-control">
                    @foreach (var item in ViewBag.ARVersion)
                    {
                        <option value="@item">@item</option>
                    }
                </select>
                <span asp-validation-for="ARVersion" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group">
            <label asp-for="FullAddress" class="control-label cip-required"></label>
            <input asp-for="FullAddress" placeholder="請填寫工廠地址" class="form-control" />
            <span asp-validation-for="FullAddress" class="text-danger"></span>
        </div>
        <div class="form-check">
            <input asp-for="BaseYear" class="form-check-input" />
            <label asp-for="BaseYear" class="form-check-label"></label>
            <span asp-validation-for="BaseYear" class="text-danger"></span>
        </div>
    </section>

    <section class="cip-section">
        <h2 class="cip-section-title">廠區圖片</h2>
        <div class="cip-form-grid">
            <div class="form-group">
                <label asp-for="OrganizationImage" class="control-label"></label>
                <input asp-for="OrganizationImage" type="file" class="form-control" accept="image/jpeg,image/png" />
            </div>
            <div class="form-group">
                <label asp-for="MapImage" class="control-label"></label>
                <input asp-for="MapImage" type="file" class="form-control" accept="image/jpeg,image/png" />
            </div>
            <div class="form-group">
                <label asp-for="ShopDrawings" class="control-label"></label>
                <input asp-for="ShopDrawings" type="file" class="form-control" accept="image/jpeg,image/png" />
            </div>
        </div>
        <p class="form-text mb-0">僅接受 JPG／PNG，單檔大小上限 5MB。</p>
    </section>

    <div class="cip-form-actions">
        <button type="submit" class="btn btn-primary">確認</button>
        @if (User.IsInRole("Admin"))
        {
            <a class="btn btn-outline-secondary" asp-controller="Areas" asp-action="Index" asp-route-id="@TempData.Peek("companyId")">取消</a>
        }
        else
        {
            <a class="btn btn-outline-secondary" asp-controller="Areas" asp-action="Index">取消</a>
        }
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
