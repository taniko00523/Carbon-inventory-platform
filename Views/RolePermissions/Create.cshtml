@model Carbon_inventory_platform.Models.RolePermission
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "新增角色權限";
}

<h1>新增角色權限</h1>

<h4>角色權限</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="RoleId" class="control-label"></label>
                <select asp-for="RoleId" class="form-control" asp-items="ViewBag.RoleId"></select>
                <span asp-validation-for="RoleId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PermissionId" class="control-label"></label>
                <select asp-for="PermissionId" class="form-control" asp-items="ViewBag.PermissionId"></select>
                <span asp-validation-for="PermissionId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="新增" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">回列表</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
