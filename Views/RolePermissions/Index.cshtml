@model IEnumerable<Carbon_inventory_platform.Models.RolePermission>

@{
    ViewData["Title"] = "角色權限列表";
}

<h1>角色權限列表</h1>

<p>
    <a asp-action="Create">新增角色權限</a>
</p>
<div class="cip-table-wrap">
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.RoleId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PermissionId)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @item.Role?.Name
            </td>
            <td>
                @item.Permission?.Name
            </td>
            <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">編輯</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">詳細資料</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">刪除</a>
            </td>
        </tr>
}
    </tbody>
</table>
</div>
