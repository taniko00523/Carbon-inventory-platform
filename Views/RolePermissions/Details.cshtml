@model Carbon_inventory_platform.Models.RolePermission

@{
    ViewData["Title"] = "角色權限詳細資料";
}

<h1>角色權限詳細資料</h1>

<div>
    <h4>角色權限</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.RoleId)
        </dt>
        <dd class = "col-sm-10">
            @Model?.Role?.Name
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PermissionId)
        </dt>
        <dd class = "col-sm-10">
            @Model?.Permission?.Name
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">編輯</a> |
    <a asp-action="Index">回列表</a>
</div>
