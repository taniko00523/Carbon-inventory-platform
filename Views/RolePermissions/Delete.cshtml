@model Carbon_inventory_platform.Models.RolePermission

@{
    ViewData["Title"] = "刪除角色權限";
}

<h1>刪除角色權限</h1>

<h3>確定要刪除這筆資料嗎？</h3>
<div>
    <h4>角色權限</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.RoleId)
        </dt>
        <dd class = "col-sm-10">
            @Model?.Role?.Name
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PermissionId)
        </dt>
        <dd class = "col-sm-10">
            @Model?.Permission?.Name
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="刪除" class="btn btn-danger" /> |
        <a asp-action="Index">回列表</a>
    </form>
</div>
