            <td>
                @Html.DisplayFor(modelItem => item.DataUUL)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DataULL)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Year)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Unit)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">編輯</a> |
                <a asp-action="Details" asp-route-id="@item.Id">詳細資料</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">刪除</a>
            </td>
        </tr>
}
    </tbody>
</table>
</div>

@await Html.PartialAsync("_Pagination", new Carbon_inventory_platform.ViewModel.PaginationViewModel
{
    CurrentPage = (int)ViewData["PageNumber"]!,
    TotalPages = (int)ViewData["TotalPages"]!,
    PageUrl = i => Url.Action("Index", new { pageNumber = i })!,
})
