@model IEnumerable<Carbon_inventory_platform.Models.Material>

@{
    ViewData["Title"] = "排放係數列表";
}

<h1>排放係數列表</h1>

<p>
    <a asp-action="Create">新增排放係數</a>
</p>
<div class="cip-table-wrap">
