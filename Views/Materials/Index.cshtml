                @Html.DisplayNameFor(model => model.CH4ULL)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CH4UUL)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.N2OCEF)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.N2OULL)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.N2OUUL)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HFCSCEF)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HFCSULL)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HFCSUUL)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PFCSCEF)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PFCSULL)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PFCSUUL)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SF6CEF)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SF6ULL)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NF3UUL)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NF3CEF)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NF3ULL)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SF6UUL)
