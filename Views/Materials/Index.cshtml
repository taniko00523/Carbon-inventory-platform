            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PFCSUUL)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SF6CEF)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SF6ULL)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NF3UUL)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NF3CEF)
