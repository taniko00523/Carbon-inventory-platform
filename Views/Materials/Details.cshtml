@model Carbon_inventory_platform.Models.Material

@{
    ViewData["Title"] = "排放係數詳細資料";
}

@* 原本 29 個欄位攤成一路 dt/dd，SF6/NF3 的順序還兜錯（NF3UUL 夾在 SF6ULL 跟 NF3CEF 中間，
   SF6UUL 又被丟到 NF3ULL 後面，畫面上看不出哪個數字屬於哪個氣體）。
   改成每種氣體一個區塊，CEF／下限／上限固定放在一起，順序目視就能核對。 *@
<div class="cip-page-head">
    <div>
        <h1>@ViewData["Title"]</h1>
    </div>
    <div class="cip-page-actions">
        <a class="btn btn-success" asp-action="Edit" asp-route-id="@Model?.Id">編輯</a>
        <a class="btn btn-outline-secondary" asp-action="Index">返回</a>
    </div>
</div>

<section class="cip-section">
    <h2 class="cip-section-title">基本資料</h2>
    <dl class="row mb-0">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Name)</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Scope)</dt>
        <dd class="col-sm-9"><span class="cip-badge cip-badge-neutral">@Model?.Scope</span></dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.EmissionPattern)</dt>
        <dd class="col-sm-9"><span class="cip-badge cip-badge-neutral">@Model?.EmissionPattern</span></dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Year)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Year)</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Unit)</dt>
        <dd class="col-sm-9 mb-0">@Html.DisplayFor(model => model.Unit)</dd>
    </dl>
</section>

<section class="cip-section">
    <h2 class="cip-section-title">CO2</h2>
    <div class="cip-form-grid">
        <div><strong>@Html.DisplayNameFor(model => model.CO2CEF)：</strong>@Html.DisplayFor(model => model.CO2CEF)</div>
        <div><strong>@Html.DisplayNameFor(model => model.CO2ULL)：</strong>@Html.DisplayFor(model => model.CO2ULL)</div>
        <div><strong>@Html.DisplayNameFor(model => model.CO2UUL)：</strong>@Html.DisplayFor(model => model.CO2UUL)</div>
    </div>
</section>

<section class="cip-section">
    <h2 class="cip-section-title">CH4</h2>
    <div class="cip-form-grid">
        <div><strong>@Html.DisplayNameFor(model => model.CH4CEF)：</strong>@Html.DisplayFor(model => model.CH4CEF)</div>
        <div><strong>@Html.DisplayNameFor(model => model.CH4ULL)：</strong>@Html.DisplayFor(model => model.CH4ULL)</div>
        <div><strong>@Html.DisplayNameFor(model => model.CH4UUL)：</strong>@Html.DisplayFor(model => model.CH4UUL)</div>
    </div>
</section>

<section class="cip-section">
