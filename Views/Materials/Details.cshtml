        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CEF_Correction)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.CEF_Correction)</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DataUUL)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.DataUUL)</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DataULL)</dt>
        <dd class="col-sm-9 mb-0">@Html.DisplayFor(model => model.DataULL)</dd>
    </dl>
</section>
