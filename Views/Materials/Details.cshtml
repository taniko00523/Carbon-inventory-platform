        <div><strong>@Html.DisplayNameFor(model => model.N2OULL)：</strong>@Html.DisplayFor(model => model.N2OULL)</div>
        <div><strong>@Html.DisplayNameFor(model => model.N2OUUL)：</strong>@Html.DisplayFor(model => model.N2OUUL)</div>
