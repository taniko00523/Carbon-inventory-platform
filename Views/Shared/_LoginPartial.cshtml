@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        @if (User.IsInRole("Admin"))
        {
            <li class="nav-item">
                <span class="nav-link text-dark" >你好，管理員</span>
            </li>
        }
        else
        {
            <li class="nav-item">
                <a class="nav-link text-dark" title="資料維護" asp-area="Identity" asp-page="/Account/Manage/Index">你好，@User.Identity?.Name!</a>
            </li>
        }
        <li class="nav-item">
            <form class="nav-item form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="btn btn-outline-secondary">登出</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">登入</a>
        </li>
    }
</ul>
