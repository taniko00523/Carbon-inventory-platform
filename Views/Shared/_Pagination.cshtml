@model Carbon_inventory_platform.ViewModel.PaginationViewModel
@if (Model.TotalPages > 1)
{
    <nav aria-label="分頁導覽">
        <ul class="pagination">
            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                <a class="page-link" href="@Model.PageUrl(Math.Max(1, Model.CurrentPage - 1))" aria-label="上一頁">&laquo;</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="@Model.PageUrl(i)">@i</a>
                </li>
            }
            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@Model.PageUrl(Math.Min(Model.TotalPages, Model.CurrentPage + 1))" aria-label="下一頁">&raquo;</a>
            </li>
        </ul>
    </nav>
}
