@model List<Carbon_inventory_platform.Models.Function>
@if (Model != null && Model.Count > 0)
{
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" href="#" id="cipInventoryBackendMenu" role="button"
           data-bs-toggle="dropdown" aria-expanded="false">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="6" rx="8" ry="3" /><path d="M4 6v6c0 1.66 3.58 3 8 3s8-1.34 8-3V6" /><path d="M4 12v6c0 1.66 3.58 3 8 3s8-1.34 8-3v-6" /></svg>
            <span>後台設定</span>
        </a>
        <ul class="dropdown-menu" aria-labelledby="cipInventoryBackendMenu">
            @foreach (var function in Model)
            {
                <li><a class="dropdown-item" asp-controller="@function.Name" asp-action="Index">@function.CName</a></li>
            }
        </ul>
    </li>
}
