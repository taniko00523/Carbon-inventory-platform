@model Carbon_inventory_platform.Models.Device

@{
    ViewData["Title"] = "修改";
}

<h1>修改</h1>

<h4>設備資料維護</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="AreaId" class="control-label"></label>
                <select asp-for="AreaId" class="form-control" asp-items="ViewBag.AreasId"></select>
                <span asp-validation-for="AreaId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AssetNo" class="control-label"></label>
                <input asp-for="AssetNo" class="form-control" />
                <span asp-validation-for="AssetNo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Provess" class="control-label"></label>
                <input asp-for="Provess" class="form-control" />
                <span asp-validation-for="Provess" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Scope" class="control-label"></label>
                <select asp-for="Scope" class="form-control" asp-items="ViewBag.Scope"></select>
                <span asp-validation-for="Scope" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EmissionPattern" class="control-label"></label>
                <select asp-for="EmissionPattern" class="form-control" asp-items="ViewBag.EmissionPattern"></select>
                <span asp-validation-for="EmissionPattern" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MaterialId" class="control-label"></label>
                <select asp-for="MaterialId" class="form-control" asp-items="ViewBag.MaterialId"></select>
                <span asp-validation-for="MaterialId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CO2" class="control-label"></label>
                <input class="form-check-input" type="checkbox" value="true" asp-for="CO2" class="form-control" />
                <span asp-validation-for="CO2" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CH4" class="control-label"></label>
                <input class="form-check-input" type="checkbox" value="true" asp-for="CH4" class="form-control" />
                <span asp-validation-for="CH4" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="N2O" class="control-label"></label>
                <input class="form-check-input" type="checkbox" value="true" asp-for="N2O" class="form-control" />
                <span asp-validation-for="N2O" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="HFCS" class="control-label"></label>
                <input class="form-check-input" type="checkbox" value="true" asp-for="HFCS" class="form-control" />
                <span asp-validation-for="HFCS" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PFCS" class="control-label"></label>
                <input class="form-check-input" type="checkbox" value="true" asp-for="PFCS" class="form-control" />
                <span asp-validation-for="PFCS" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SF6" class="control-label"></label>
                <input class="form-check-input" type="checkbox" value="true" asp-for="SF6" class="form-control" />
                <span asp-validation-for="SF6" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NF3" class="control-label"></label>
                <input class="form-check-input" type="checkbox" value="true" asp-for="NF3" class="form-control" />
                <span asp-validation-for="NF3" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="儲存" class="btn btn-primary" />|
                <a class="btn btn-secondary" asp-action="Index">返回</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
