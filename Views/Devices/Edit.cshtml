@model Carbon_inventory_platform.ViewModel.DeviceViewModel

@{
    ViewData["Title"] = "排放源資料維護";
}

@* 同 Create.cshtml 的排版問題：col-md-4 太窄、自訂排放係數欄位沒有間距、jQuery 重複載入。
   下面所有 id 都被 <script> 直接操作，只調整外層排版，不更動 id/asp-for。 *@
<div class="cip-page-head">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p class="cip-page-sub">@Model.Name</p>
    </div>
    <div class="cip-page-actions">
        <a class="btn btn-outline-secondary" asp-controller="Devices" asp-action="Index" asp-route-id="@TempData.Peek("areaId")">返回</a>
    </div>
</div>

<form asp-action="Edit" id="DeviceEdit">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" id="id" />
    <input type="hidden" asp-for="AreaId" class="form-control" />

    <section class="cip-section">
        <h2 class="cip-section-title">排放源資料</h2>
        <div class="form-group">
            <label asp-for="Name" class="control-label cip-required"></label>
            <div class="d-flex align-items-center gap-2">
                <input asp-for="Name" class="form-control" list="NameList" placeholder="排放源名稱" />
                <input asp-for="NameRemark" class="form-control" placeholder="備註 可不填" />
            </div>
            <datalist id="NameList">
                @foreach (var item in (SelectList)ViewData["name"])
                {
                    <option value="@item.Text"></option>
                }
            </datalist>
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="cip-form-grid">
            <div class="form-group">
                <label asp-for="Scope" class="control-label cip-required"></label>
                <select asp-for="Scope" class="form-control" id="scopeDropdown" asp-items="ViewBag.Scope"></select>
                <span asp-validation-for="Scope" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EmissionPattern" class="control-label cip-required"></label>
                <select asp-for="EmissionPattern" class="form-control" id="emissionDropdown" asp-items="ViewBag.EmissionPattern"></select>
                <span asp-validation-for="EmissionPattern" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group">
            <label asp-for="Material" class="control-label cip-required"></label>
            @Html.TextBoxFor(x => x.Material, new { @list = "MaterialList", @class = "form-control" })
            <datalist id="MaterialList"></datalist>
            <span asp-validation-for="Material" id="lbMaterial" class="text-danger"></span>
        </div>
        <div class="cip-form-grid">
            <div class="form-group">
                <label asp-for="AssetNo" class="control-label"></label>
                <input asp-for="AssetNo" class="form-control" />
                <span asp-validation-for="AssetNo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Provess" class="control-label"></label>
                <input asp-for="Provess" class="form-control" />
                <span asp-validation-for="Provess" class="text-danger"></span>
            </div>
        </div>
        <div class="form-check">
            <input type="checkbox" class="form-check-input" value="True" id="CEFCustomize">
            <input asp-for="Customize" type="hidden" id="CEFCustomizeHidden">
            @* 原本 for="flexCheckChecked" 指向一個畫面上根本不存在的 id，點文字完全沒反應。 *@
            <label asp-for="Customize" class="form-check-label" for="CEFCustomize"></label>
        </div>
    </section>

    <section class="cip-section" id="CEF" style="display:none;">
        <h2 class="cip-section-title">自訂排放係數</h2>
        <div class="cip-form-grid">
            <div class="form-group">
                <label asp-for="CO2CEF" class="control-label"></label>
                <input asp-for="CO2CEF" class="form-control cef-input" id="CO2CEF" type="number" step="0.0000000001" />
            </div>
            <div class="form-group">
                <label asp-for="CH4CEF" class="control-label"></label>
                <input asp-for="CH4CEF" class="form-control cef-input" id="CH4CEF" type="number" step="0.0000000001" />
            </div>
            <div class="form-group">
                <label asp-for="N2OCEF" class="control-label"></label>
                <input asp-for="N2OCEF" class="form-control cef-input" id="N2OCEF" type="number" step="0.0000000001" />
            </div>
            <div class="form-group">
                <label asp-for="HFCSCEF" class="control-label"></label>
                <input asp-for="HFCSCEF" class="form-control cef-input" id="HFCSCEF" type="number" step="0.0000000001" />
            </div>
            <div class="form-group">
                <label asp-for="PFCSCEF" class="control-label"></label>
                <input asp-for="PFCSCEF" class="form-control cef-input" id="PFCSCEF" type="number" step="0.0000000001" />
            </div>
            <div class="form-group">
                <label asp-for="SF6CEF" class="control-label"></label>
                <input asp-for="SF6CEF" class="form-control cef-input" id="SF6CEF" type="number" step="0.0000000001" />
            </div>
            <div class="form-group">
                <label asp-for="NF3CEF" class="control-label"></label>
                <input asp-for="NF3CEF" class="form-control cef-input" id="NF3CEF" type="number" step="0.0000000001" />
            </div>
        </div>
    </section>

    <div class="cip-form-actions">
        <button type="button" class="btn btn-primary" onclick="Save();">儲存</button>
        <a class="btn btn-outline-secondary" asp-controller="Devices" asp-action="Index" asp-route-id="@TempData.Peek("areaId")">取消</a>
    </div>
</form>


@section scripts
{
    @* layout 已經在 @@RenderSectionAsync("Scripts") 之前載入本機的 jQuery，這裡原本重複載入的 CDN 版本已移除。 *@
    <script>
        $(document).ready(function () {
            // 加載頁面時立即執行的程式碼
            docReadyLoadDeviceData();
            OtherName();
            checkCEF();

            // Name 的 change 事件處理
            $('#Name').change(function () {
                OtherName();
                loadDefaultDeviceData();
            });

            $('#CEFCustomize').change(CEFCustomize);

            // scopeDropdown 的 change 事件處理
            $('#scopeDropdown').change(function () {
                var selectedScope = $(this).val();
                loadEmissionsAndMaterial(selectedScope);
            });

            // emissionDropdown 的 change 事件處理
            $('#emissionDropdown').change(function () {
                var selectedEmission = $(this).val();
                loadMaterialsAndGWPNames(selectedEmission);
            });

            function updateMaterialPlaceholder() {
                if ($('#MaterialList option').length === 0) {
                    $('#Material').attr('placeholder', '請填寫原燃物料');
                } else {
                    $('#Material').attr('placeholder', '請選擇原燃物料');

                }
            }

            function docReadyLoadDeviceData() {
                var id = $('#id').val();
                $.ajax({
                    url: '/Devices/GetDeviceData',
                    type: 'GET',
                    data: { id: id },
                    async: false,
                    success: function (data) {
                        // 原本沒有檢查 data 是否為 null，但 GetDeviceData 在找不到設備或沒有權限存取時
                        // 會回傳 200 + null，直接解構 null 會丟出 JS 例外，讓下拉選單完全載入不出來且沒有提示。
                        if (!data) {
                            alert("讀取設備資料失敗，請重新整理頁面");
                            return;
                        }
                        var { scope, emissionPattern, material } = data;
                        loadEmissions(scope, function () {
                            var selectedMaterial = $('#Material').val()
                            loadMaterialsAndGWPNames(emissionPattern, material);
                            $('#emissionDropdown').val(emissionPattern);
                            setTimeout(() => {
                                //改
                                $('#Material').val(selectedMaterial);
                            }, 50) //設定延遲
                            
                        });
                    },
                    error: function (error) {
                        console.log(error);
                    }
                });
            }

            function loadDefaultDeviceData() {
                var selectedName = $('#Name').val();
                $.ajax({
                    url: '/Devices/GetDefaultDeviceData',
                    type: 'GET',
                    data: { selectedName: selectedName },
                    async: false,
                    success: function (data) {
                        var { scope, emissionPattern, material } = data;
                        loadEmissions(scope, function () {
                            loadMaterialsAndGWPNames(emissionPattern, material);
                            $('#emissionDropdown').val(emissionPattern);
                        });
                    },
                    error: function (error) {
                        console.log(error);
                    }
                });
            }

            function loadEmissions(scope, callback) {
                $.ajax({
                    url: '/Devices/GetEmissions',
                    type: 'GET',
                    data: { scope: scope },
                    success: function (data) {
                        $('#emissionDropdown').empty();
                        data.forEach(item => {
                            $('#emissionDropdown').append($('<option>', {
                                value: item,
                                text: item
                            }));
                        });
                        $('#scopeDropdown').val(scope);
                        if (callback && typeof callback === 'function') {
                            callback();
                        }
                    },
                    error: function (error) {
                        console.log(error);
                    }
                });
            }

            function loadEmissionsAndMaterial(scope) {
                loadEmissions(scope, function () {
                    $('#emissionDropdown').trigger('change');
                });
            }

            function loadMaterialsAndGWPNames(emissionPattern, material = null) {
                $.ajax({
                    url: '/Devices/GetMaterialsAndGWPNames',
                    type: 'GET',
                    data: { emissionPattern: emissionPattern },
                    success: function (data) {
                        $('#MaterialList').empty();
                        data.materials.forEach(item => {
                            $('#MaterialList').append($('<option>', {
                                value: item.name,
                                text: item.name
                            }));
                        });
                        data.gwpNames.forEach(item => {
                            $('#MaterialList').append($('<option>', {
                                value: item.name,
                                text: item.name
                            }));
                        });
                        if (material && emissionPattern != "逸散") {
                            $('#Material').val(material);
                        } else {
                            $('#Material').val("");
                        }
                        updateMaterialPlaceholder();
                    },
                    error: function (error) {
                        console.log(error);
                    }
                });
            }

            function OtherName() {
                var name = $('#Name').val();
                var nameMatchFound = $('#NameList option').filter(function () {
                    return this.value === name;
                }).length > 0;

                if (name === "") {
                    return;
                }

                if (!nameMatchFound) {
                    $('#CEFCustomize').prop('checked', true).prop('disabled', true).trigger('change');
                } else {
                    $('#CEFCustomize').prop('checked', false).prop('disabled', false).trigger('change');
                }
            }

            function CEFCustomize() {
                if ($('#CEFCustomize').prop('checked')) {
                    // 如果 CEFCustomize 被选中，则显示相关的元素或执行其他操作
                    $('#CEF').show();
                    $('#CEFCustomizeHidden').val('true');
                } else {
                    // 如果 CEFCustomize 没有被选中，则隐藏相关的元素或执行其他操作
                    $('#CEF').hide();
                    $('#CEFCustomizeHidden').val('false');
                }
            }

            function checkCEF() {
                if ($('#CEFCustomizeHidden').val() === 'True') {
                    $('#CEFCustomize').prop('checked', true);
                    $('#CEF').show();
                } else {
                    $('#CEFCustomize').prop('checked', false);
                    $('#CEF').hide();
                }
            }

            $('#submitBtn').click(function () {
                if ($('#CEFCustomize').prop('checked') || $('#CEF').is(':visible')) {
                    var totalCef = $('.cef-input').toArray().reduce((sum, input) => {
                        var value = parseFloat($(input).val().trim());
                        return !isNaN(value) ? sum + value : sum;
                    }, 0);

                    if (totalCef <= 0) {
                        alert('請輸入自訂排放係數');
                        return false;
                    }
                }
            });
        });

        function Save() {
            var name = $('#Name').val();
            var material = $('#Material').val();
            var nameMatchFound = $('#NameList option').filter(function () {
                return this.value === name;
            }).length > 0;

            if (!nameMatchFound && !material.trim()) {
                $('#lbMaterial').text("請輸入原燃物料");
                return false;
            } else if (nameMatchFound) {
                var materialMatchFound = $('#MaterialList option').filter(function () {
                    return this.value === material;
                }).length > 0;

                if (!materialMatchFound) {
                    $('#lbMaterial').text("請選擇有效的原燃物料");
                    return false;
                }
            }

            $('#lbMaterial').text("");
            $("#DeviceEdit").submit();
        }
    </script>
}
