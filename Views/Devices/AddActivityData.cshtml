@model Carbon_inventory_platform.ViewModel.ActivityDataViewModel

@{
    ViewData["Title"] = "活動數據設定";
}

@* 原本表單塞進 col-md-4；另外 Device.Name（隱藏）與 Device.Source（可見）兩個輸入框
   共用同一個 id="nameInput"，是不合法的重複 id，只是恰好排在前面的隱藏欄位先被抓到
   才「看起來」沒事。這裡把 Source 的 id 改掉，並移除重複的 CDN jQuery 載入。 *@
<div class="cip-page-head">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p class="cip-page-sub">@Model.Device.Name ・ @Model.Device.Material</p>
    </div>
    <div class="cip-page-actions">
        <a class="btn btn-outline-secondary" asp-controller="Devices" asp-action="Index" asp-route-id="@TempData.Peek("areaId")">返回</a>
    </div>
</div>

<section class="cip-section">
    <form asp-action="AddActivityData">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group" style="display:none">
            <input asp-for="Device.Name" id="nameInput" class="form-control" />
            <span asp-validation-for="Device.Name" class="text-danger"></span>
        </div>
        <div id="activityDataFields" class="form-group">
            @* 初始的ActivityData欄位 *@
            <div class="activity-data">
                <input asp-for="ActivityDataList[0].id" type="hidden"></input>
                <label asp-for="ActivityDataList[0].Num" class="control-label"></label>
                <input asp-for="ActivityDataList[0].Num" type="number" class="form-control" step="any">
           </div>
        </div>
        <div class="cip-form-grid">
            <div class="form-group">
                <label asp-for="Device.Unit" class="control-label"></label>
                <select asp-for="Device.Unit" class="form-control" id="unitDropdown" asp-items="ViewBag.Unit"></select>
                <span asp-validation-for="Device.Unit" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Device.Source" class="control-label"></label>
                <input asp-for="Device.Source" id="sourceInput" class="form-control" />
                <span asp-validation-for="Device.Source" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Device.Data_Correction" class="control-label"></label>
                <select asp-for="Device.Data_Correction" class="form-control" id="levelDropdown" asp-items="ViewBag.DataCorrections"></select>
                <span asp-validation-for="Device.Data_Correction" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Device.Device_Correction" class="control-label"></label>
                <select asp-for="Device.Device_Correction" class="form-control" id="correctionDropdown" asp-items="ViewBag.DeviceCorrection"></select>
                <span asp-validation-for="Device.Device_Correction" class="text-danger"></span>
            </div>
        </div>
        <input type="hidden" asp-for="Device.Id" id="id" />
        <div class="cip-form-actions">
            <button type="submit" class="btn btn-primary">確認</button>
            <a class="btn btn-outline-secondary" asp-controller="Devices" asp-action="Index" asp-route-id="@TempData.Peek("areaId")">取消</a>
        </div>
    </form>
</section>

@section scripts
{
    @* layout 已經載入本機 jQuery，這裡原本重複載入的 CDN 版本已移除。 *@
    <script>
        $(document).ready(function () {
            // 獲取 nameDropdown 的值
            var selectedName = $('#nameInput').val();
            var id = $('#id').val();

            // 发送 AJAX 请求获取相应的 DeviceData
            $.ajax({
                url: '/Devices/GetDeviceLevelAndCorrection',  // 正確的端點
                type: 'GET',
                data: { selectedName: selectedName, id: id },  // 替換為實際的 device id
                success: function (data) {
                    // 原本沒有檢查 data 是否為 null，但這支 API 在找不到設備或沒有權限存取時
                    // 會回傳 200 + null（而不是錯誤狀態碼），直接讀 data.num 會丟出 JS 例外，
                    // 讓後續的下拉選單初始化整個中斷且畫面上完全沒有提示。
                    if (data && data.num == 0) {
                        // 更新 levelDropdown 和 correctionDropdown
                        $('#levelDropdown').val(data.level);
                        $('#correctionDropdown').val(data.correction);
                        $('#unitDropdown').val(data.unit);
                    }
                },
                error: function (error) {
                    console.log(error);
                }
            });


            return false;
        });
    </script>
}
