@model Carbon_inventory_platform.ViewModel.ActivityDataViewModel

@{
    ViewData["Title"] = "活動數據設定";
}

<h1>@ViewData["Title"]</h1>

<h4>@Model.Device.Name</h4>
<h4>@Model.Device.Material</h4>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="AddActivityData">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group" style="display:none">
                <input asp-for="Device.Name" id="nameInput" class="form-control" />
                <span asp-validation-for="Device.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Device.Unit" class="control-label"></label>
                <select asp-for="Device.Unit" class="form-control" id="unitDropdown" asp-items="ViewBag.Unit"></select>
                <span asp-validation-for="Device.Unit" class="text-danger"></span>
            </div> 
            @* <div class="form-group">
            <label asp-for="Source" class="control-label"></label>
            <select asp-for="Source" class="form-control" asp-items="ViewBag.Source"></select>
            <span asp-validation-for="Source" class="text-danger"></span>
            </div> *@
            @*  <div class="form-group">
            <label asp-for="Dept" class="control-label"></label>
            <input asp-for="Dept" class="form-control" />
            <span asp-validation-for="Dept" class="text-danger"></span>
            </div> *@
            <div class="form-group">
                <label asp-for="Device.Data_Correction" class="control-label"></label>
                <select asp-for="Device.Data_Correction" class="form-control" id="levelDropdown" asp-items="ViewBag.DataCorrections"></select>
                <span asp-validation-for="Device.Data_Correction" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Device.Device_Correction" class="control-label"></label>
                <select asp-for="Device.Device_Correction" class="form-control" id="correctionDropdown" asp-items="ViewBag.DeviceCorrection"></select>
                <span asp-validation-for="Device.Device_Correction" class="text-danger"></span>
            </div>
            <div id="activityDataFields">
                @* 初始的ActivityData欄位 *@
                <div class="activity-data">
                    @Html.HiddenFor(model => model.ActivityDataList[0].id)
                    @Html.LabelFor(model => model.ActivityDataList[0].Num)
                    @Html.TextBoxFor(model => model.ActivityDataList[0].Num)
                    @Html.LabelFor(model => model.ActivityDataList[0].Time)
                    @Html.TextBoxFor(model => model.ActivityDataList[0].Time)
                    @Html.LabelFor(model => model.ActivityDataList[0].remark)
                    @Html.TextBoxFor(model => model.ActivityDataList[0].remark)
                </div>
            </div>
            <button type="button" id="addActivityData">新增ActivityData</button>

            <div class="form-group">
                <input type="hidden" asp-for="Device.Id" id="id" />
                <input type="submit" value="確認" class="btn btn-primary" />|
                <a class="btn btn-secondary" asp-controller="Devices" asp-action="Index" asp-route-id="@TempData.Peek("areaId")">返回</a>
            </div>
        </form>
    </div>
</div>

@section scripts
{
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            checkActivityData();

            // 獲取 nameDropdown 的值
            var selectedName = $('#nameInput').val();
            var id = $('#id').val();

            // 发送 AJAX 请求获取相应的 DeviceData
            $.ajax({
                url: '/Devices/GetDeviceLevelAndCorrection',  // 正確的端點
                type: 'GET',
                data: { selectedName: selectedName, id: id },  // 替換為實際的 device id
                success: function (data) {
                    // 添加條件判斷
                    if (data.num == 0) {
                        // 更新 levelDropdown 和 correctionDropdown
                        $('#levelDropdown').val(data.level);
                        $('#correctionDropdown').val(data.correction);
                        $('#unitDropdown').val(data.unit);
                    }
                },
                error: function (error) {
                    console.log(error);
                }
            });

            $("#addActivityData").click(function () {
                var newIndex = $(".activity-data").length;
                var newField = $('<div class="activity-data">' +
                    '<label for="ActivityDataList_' + newIndex + '__Num">Num</label>' +
                    '<input type="text" name="ActivityDataList[' + newIndex + '].Num" id="ActivityDataList_' + newIndex + '__Num" />' +
                    '<label for="ActivityDataList_' + newIndex + '__Time">Time</label>' +
                    '<input type="text" name="ActivityDataList[' + newIndex + '].Time" id="ActivityDataList_' + newIndex + '__Time" />' +
                    '<label for="ActivityDataList_' + newIndex + '__remark">Remark</label>' +
                    '<input type="text" name="ActivityDataList[' + newIndex + '].remark" id="ActivityDataList_' + newIndex + '__remark" />' +
                    '</div>');
                $("#activityDataFields").append(newField);

            });

            function checkActivityData() {
                var activityDataList = @Html.Raw(Json.Serialize(Model.ActivityDataList));
                for (var i = 0; i < activityDataList.length; i++) {
                    var activityData = activityDataList[i];
                    var newField = $('<div class="activity-data">' +
                        '<label for="ActivityDataList_' + i + '__Num">Num</label>' +
                        '<input type="text" name="ActivityDataList[' + i + '].Num" id="ActivityDataList_' + i + '__Num" value="' + activityData.Num + '" />' +
                        '<label for="ActivityDataList_' + i + '__Time">Time</label>' +
                        '<input type="text" name="ActivityDataList[' + i + '].Time" id="ActivityDataList_' + i + '__Time" value="' + activityData.Time + '" />' +
                        '<label for="ActivityDataList_' + i + '__remark">Remark</label>' +
                        '<input type="text" name="ActivityDataList[' + i + '].remark" id="ActivityDataList_' + i + '__remark" value="' + activityData.remark + '" />' +
                        '</div>');
                    $("#activityDataFields").append(newField);
                }
            }
            return false;
        });
    </script>
}
