    @model Carbon_inventory_platform.ViewModel.DeviceViewModel

@{
    ViewData["Title"] = "排放源資料新增";
}

<h1>新增</h1>
<h4>@ViewData["Title"]</h4>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<form asp-action="Create" id="DeviceCreate">
    <div class="row">
        <div class="col-md-4">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="AreaId" value="@TempData.Peek("areaId")" />
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label><span style="color:red">*</span>
                <div class="d-flex align-items-center">
                    <input asp-for="Name" class="form-control mr-2" list="NameList" placeholder="排放源名稱" />
                    (<input asp-for="NameRemark" class="form-control" placeholder="備註 可不填" />)
                </div>
                <datalist id="NameList">
                    @foreach (var item in (SelectList)ViewData["name"])
                    {
                        <option value="@item.Text"></option>
                    }
                </datalist>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Scope" class="control-label"></label><span style="color:red">*</span>
                <select asp-for="Scope" class="form-control" id="scopeDropdown" asp-items="ViewBag.Scope">
                    <option value="" disabled selected>請選擇類別</option>
                </select>
                <span asp-validation-for="Scope" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EmissionPattern" class="control-label"></label><span style="color:red">*</span>
                <select asp-for="EmissionPattern" class="form-control" id="emissionDropdown">
                    <option value="" disabled selected>請先選擇類別</option>
                </select>
                <span asp-validation-for="EmissionPattern" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Material" class="control-label"></label><span style="color:red">*</span>
                @Html.TextBoxFor(x => x.Material, new { @list = "MaterialList", @class = "form-control", @placeholder = "輸入或者選擇原燃物料選項" })
                <datalist id="MaterialList"></datalist>
                <span asp-validation-for="Material" id="lbMaterial" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AssetNo" class="control-label"></label>
                <input asp-for="AssetNo" class="form-control" />
                <span asp-validation-for="AssetNo" class="text-danger"></span>
            </div><div class="form-group">
                <label asp-for="Provess" class="control-label"></label>
                <input asp-for="Provess" class="form-control" />
                <span asp-validation-for="Provess" class="text-danger"></span>
            </div>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" value="true" id="CEFCustomize">
                <input asp-for="Customize" type="hidden" value="false" id="CEFCustomizeHidden">
                <label asp-for="Customize" class="form-check-label" for="flexCheckChecked"></label>
            </div>

            <div class="form-group">
                <a class="btn btn-primary" onclick="Save();">新增</a>|
                <a class="btn btn-secondary" asp-controller="Devices" asp-action="Index" asp-route-id="@TempData.Peek("areaId")">返回</a>
            </div>
        </div>

        <div class="col-md-4" id="CEF" style="display:none;">
            <label asp-for="CO2CEF" class="control-label"></label>
            <input asp-for="CO2CEF" class="form-control cef-input" id="CO2CEF" type="number" step="0.0000000001" />
            <label asp-for="CH4CEF" class="control-label"></label>
            <input asp-for="CH4CEF" class="form-control cef-input" id="CH4CEF" type="number" step="0.0000000001" />
            <label asp-for="N2OCEF" class="control-label"></label>
            <input asp-for="N2OCEF" class="form-control cef-input" id="N2OCEF" type="number" step="0.0000000001" />
            <label asp-for="HFCSCEF" class="control-label"></label>
            <input asp-for="HFCSCEF" class="form-control cef-input" id="HFCSCEF" type="number" step="0.0000000001" />
            <label asp-for="PFCSCEF" class="control-label"></label>
            <input asp-for="PFCSCEF" class="form-control cef-input" id="PFCSCEF" type="number" step="0.0000000001" />
            <label asp-for="SF6CEF" class="control-label"></label>
            <input asp-for="SF6CEF" class="form-control cef-input" id="SF6CEF" type="number" step="0.0000000001" />
            <label asp-for="NF3CEF" class="control-label"></label>
            <input asp-for="NF3CEF" class="form-control cef-input" id="NF3CEF" type="number" step="0.0000000001" />
        </div>
    </div>
</form>

@section scripts
{
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        function Save() {
            var pos = 0;
            var nameMatchFound = false;
            var name = document.getElementById('Name').value;
            var NameDatalist = document.getElementById('NameList');
            var NameOptions = NameDatalist.querySelectorAll('option');
            var material = document.getElementById('Material').value;

            for (var i = 0; i < NameOptions.length; i++) {
                if (NameOptions[i].value === name) {
                    nameMatchFound = true;
                    break;
                }
            }
            if (!nameMatchFound) {
                if (material.trim() == "") {
                    pos++;
                    document.getElementById("lbMaterial").innerHTML = "請輸入原燃物料";
                } else {
                    document.getElementById("lbMaterial").innerHTML = "";
                }
            } else {
                var MaterialDatalist = document.getElementById('MaterialList');
                var MaterialOptions = MaterialDatalist.querySelectorAll('option');
                var materialMatchFound = false;
                for (var i = 0; i < MaterialOptions.length; i++) {
                    if (MaterialOptions[i].value === material) {
                        materialMatchFound = true;
                        break;
                    }
                }
                if (!materialMatchFound) {
                    pos++;
                    document.getElementById("lbMaterial").innerHTML = "請選擇有效的原燃物料";
                } else {
                    document.getElementById("lbMaterial").innerHTML = "";
                }
            }

            if (pos > 0) {
                return false;
            } else {
                $("#DeviceCreate").submit();
            }
        }
        // document.addEventListener('DOMContentLoaded', function () {
        //     var materialInput = document.getElementById('Material');
        //     var materialDatalist = document.getElementById('MaterialList');

        //     function setMaterialPlaceholder() {
        //         var materialOptions = materialDatalist.querySelectorAll('option');
        //         console.log(materialOptions.length);
        //         if (materialOptions.length === 0) {
        //             materialInput.setAttribute('placeholder', 'Enter material');
        //         } else {
        //             materialInput.setAttribute('placeholder', 'Enter or select a material');
        //         }
        //     }

        //     // Call the function to set the initial placeholder
        //     setMaterialPlaceholder();

        //     // Optionally, you can call this function whenever the datalist is updated
        //     // For example, if options are added dynamically via AJAX
        //     // You can attach the function to the relevant event or callback
        // });


        $(document).ready(function () {
            // 加載頁面時立即執行的程式碼

            // Name 的 change 事件處理
            $('#Name').change(function () {
                var selectedName = $(this).val();
                // 當用戶選擇名字時，重新加載相關數據
                loadDefaultDeviceData();
            });

            // scopeDropdown 的 change 事件處理
            $('#scopeDropdown').change(function () {
                var selectedScope = $(this).val();
                // 當類別選項改變時，重新加載相關數據
                loadEmissionsAndMaterial(selectedScope);
            });

            // emissionDropdown 的 change 事件處理
            $('#emissionDropdown').change(function () {
                var selectedEmission = $(this).val();
                // 當排放選項改變時，重新加載相關數據
                loadMaterialsAndGWPNames(selectedEmission);
            });

            // 抓取選擇的排放源名稱
            function loadDefaultDeviceData() {
                var selectedName = $('#Name').val();
                $.ajax({
                    url: '/Devices/GetDefaultDeviceData',
                    type: 'GET',
                    data: { selectedName: selectedName },
                    async: false,
                    success: function (data) {
                        var selectedScope = data.scope; //類別
                        var selectedEmission = data.emissionPattern; //排放型式
                        var selectedMaterial = data.material; //原物料
                        loadEmissions(selectedScope);
                        setTimeout(() => {
                            loadMaterialsAndGWPNames(selectedEmission, selectedMaterial);
                        }, 100) //設定延遲

                        $('#emissionDropdown').val(selectedEmission);
                        //$('#MaterialList').val(selectedMaterial);
                    },
                    error: function (error) {
                        console.log(error);
                    }
                });
            }

            // 當類別下拉選單改變時，依據類別抓取排放源的所有排放型式
            function loadEmissions(selectedScope) {
                $.ajax({
                    url: '/Devices/GetEmissions',
                    type: 'GET',
                    data: { scope: selectedScope },
                    success: function (data) {
                        $('#emissionDropdown').empty(); //清空排放源下拉選單
                        $.each(data, function (i, item) {
                            $('#emissionDropdown').append($('<option>', {
                                value: item,
                                text: item
                            }));
                        });
                        $('#scopeDropdown').val(selectedScope);
                    },
                    error: function (error) {
                        console.log(error);
                    }
                });
            }

            function loadEmissionsAndMaterial(selectedScope) {
                $.ajax({
                    url: '/Devices/GetEmissions',
                    type: 'GET',
                    data: { scope: selectedScope },
                    success: function (data) {
                        $('#emissionDropdown').empty(); //清空排放源下拉選單
                        $.each(data, function (i, item) {
                            $('#emissionDropdown').append($('<option>', {
                                value: item,
                                text: item
                            }));
                        });
                        $('#scopeDropdown').val(selectedScope);
                        $('#emissionDropdown').trigger('change'); //觸發排放型式下拉選項改變
                    },
                    error: function (error) {
                        console.log(error);
                    }
                });
            }

            // 當排放型式下拉選單改變時，依據排放型式抓取所有物料
            function loadMaterialsAndGWPNames(selectedEmission, selectedMaterial) {
                $.ajax({
                    url: '/Devices/GetMaterialsAndGWPNames',
                    type: 'GET',
                    data: { emissionPattern: selectedEmission },
                    success: function (data) {
                        $('#MaterialList').empty();
                        $.each(data.materials, function (i, item) {
                            $('#MaterialList').append($('<option>', {
                                value: item.name,
                                text: item.name
                            }));
                        });
                        $.each(data.gwpNames, function (i, item) {
                            $('#MaterialList').append($('<option>', {
                                value: item.name,
                                text: item.name
                            }));
                        });
                        $('#emissionDropdown').val(selectedEmission);
                        if (selectedMaterial != null) {
                            if (selectedEmission != "逸散") {
                                $('#Material').val(selectedMaterial);
                            } else {
                                $('#Material').val("");
                            }
                        }
                    },
                    error: function (error) {
                        console.log(error);
                    }
                });
            }


            // Name 的值為 "其他" 時，顯示 OtherName
            $('#Name').change(function () {
                OtherName();
            });


            $('#CEFCustomize').change(function () {
                CEFCustomize();
            });

            function OtherName() {
                var nameMatchFound = false;
                var name = document.getElementById('Name').value;
                
                var $cefCustomize = $('#CEFCustomize');
                if (name != "") { //改
                    var NameDatalist = document.getElementById('NameList');
                    var NameOptions = NameDatalist.querySelectorAll('option');
                    for (var i = 0; i < NameOptions.length; i++) {
                        if (NameOptions[i].value === name) {
                            nameMatchFound = true; // 非其他排放源
                            break;
                        }
                    }
                }
                

                if (!nameMatchFound) {
                    //其他排放源
                    $cefCustomize.prop('checked', true).prop('disabled', true).trigger('change');
                } else {
                    // 非其他排放源
                    $cefCustomize.prop('checked', false).prop('disabled', false).trigger('change');
                }
            }


            function CEFCustomize() {
                if ($('#CEFCustomize').prop('checked')) {
                    // 如果 CEFCustomize 被选中，则显示相关的元素或执行其他操作
                    $('#CEF').show();
                    $('#CEFCustomizeHidden').val('true');
                } else {
                    // 如果 CEFCustomize 没有被选中，则隐藏相关的元素或执行其他操作
                    $('#CEF').hide();
                    $('#CEFCustomizeHidden').val('false');
                }
            }

            $('#submitBtn').click(function () {
                // 如果 CEFCustomize 复选框被选中，或者 CEF 区域可见
                if ($('#CEFCustomize').prop('checked') || $('#CEF').is(':visible')) {
                    var totalCef = 0; // 初始化总和

                    // 计算所有输入字段的值的总和
                    $('.cef-input').each(function () {
                        var value = parseFloat($(this).val().trim());
                        if (!isNaN(value)) {
                            totalCef += value;
                        }
                    });

                    // 如果总和小于等于0，则显示警告
                    if (totalCef <= 0) {
                        alert('請輸入自訂排放係數');
                        return false; // 阻止提交表单
                    }
                }
            });


        });

    </script>
}

