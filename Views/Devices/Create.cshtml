@model Carbon_inventory_platform.Models.Device

@{
    ViewData["Title"] = "新增";
}

<h1>新增</h1>
<h4>設備資料維護</h4>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="AreaId" value="@TempData.Peek("SelectedAreaId")" />
            @* <div class="form-group">
            <label asp-for="AssetNo" class="control-label"></label>
            <input asp-for="AssetNo" class="form-control" />
            <span asp-validation-for="AssetNo" class="text-danger"></span>
            </div> *@
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <select asp-for="Name" class="form-control" id="nameDropdown" asp-items="ViewBag.Name">
                </select>
                <input asp-for="Name" class="form-control" id="OtherName" style="display:none;" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            @*  <div class="form-group">
            <label asp-for="Provess" class="control-label"></label>
            <input asp-for="Provess" class="form-control" />
            <span asp-validation-for="Provess" class="text-danger"></span>
            </div> *@
            <div class="form-group">
                <label asp-for="Scope" class="control-label"></label>
                <select asp-for="Scope" class="form-control" id="scopeDropdown" asp-items="ViewBag.Scope"></select>
                <span asp-validation-for="Scope" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="EmissionPattern" class="control-label"></label>
                <select asp-for="EmissionPattern" class="form-control" id="emissionDropdown" asp-items="ViewBag.EmissionPattern"></select>
                <span asp-validation-for="EmissionPattern" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Material" class="control-label"></label>
                <select asp-for="Material" class="form-control" id="MaterialDropdown" asp-items="ViewBag.Material"></select>
            </div>

            @section scripts
            {
                <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
                <script>
                    $(document).ready(function () {
                        $('#nameDropdown').change(function () {
                            var selectedName = $(this).val();

                            // 发送 AJAX 请求获取相应的DeviceData
                            $.ajax({
                                url: '/Devices/GetDeviceData',
                                type: 'GET',
                                data: { selectedName: selectedName },
                                success: function (data) {
                                    // 获取DeviceData中的Scope和EmissionPattern
                                    var selectedScope = data.scope;
                                    var selectedEmission = data.emissionPattern;
                                    var selectedMaterial = data.material;

                                    // 更新 scopeDropdown 和 emissionDropdown
                                    $('#scopeDropdown').val(selectedScope);
                                    
                                    // 发送AJAX请求获取相应的emission选项
                                    $.ajax({
                                        url: '/Devices/GetEmissionsByScope',
                                        type: 'GET',
                                        data: { scope: selectedScope },
                                        success: function (data) {
                                            // 清空emissionDropdown的选项
                                            $('#emissionDropdown').empty();

                                            // 添加新的emission选项
                                            $.each(data, function (i, item) {
                                                $('#emissionDropdown').append($('<option>', {
                                                    value: item,
                                                    text: item
                                                }));
                                            });

                                            $('#emissionDropdown').val(selectedEmission);
                                        },
                                        error: function (error) {
                                            console.log(error);
                                        }
                                    });

                                    // 发送 AJAX 请求获取相应的数据
                                    $.ajax({
                                        url: '/Devices/GetMaterialsAndGWPNames',
                                        type: 'GET',
                                        data: { emissionPattern: selectedEmission },
                                        success: function (data) {
                                            // 清空MaterialDropdown的选项
                                            $('#MaterialDropdown').empty();

                                            // 添加新的Material选项
                                            $.each(data.materials, function (i, item) {
                                                $('#MaterialDropdown').append($('<option>', {
                                                    value: item.name,
                                                    text: item.name
                                                }));
                                            });

                                            // 添加新的GWPNames选项
                                            $.each(data.gwpNames, function (i, item) {
                                                $('#MaterialDropdown').append($('<option>', {
                                                    value: item.name,
                                                    text: item.name
                                                }));
                                            });

                                            // 更新 MaterialDropdown 的选中项
                                            $('#MaterialDropdown').val(selectedMaterial);
                                        },
                                        error: function (error) {
                                            console.log(error);
                                        }
                                    });
                                },
                                error: function (error) {
                                    console.log(error);
                                }
                            });
                            return false;
                        });

                        // 处理scopeDropdown的变化
                        $('#scopeDropdown').change(function () {
                            var selectedScope = $(this).val();

                            // 发送AJAX请求获取相应的emission选项
                            $.ajax({
                                url: '/Devices/GetEmissionsByScope',
                                type: 'GET',
                                data: { scope: selectedScope },
                                success: function (data) {
                                    // 清空emissionDropdown的选项
                                    $('#emissionDropdown').empty();

                                    // 添加新的emission选项
                                    $.each(data, function (i, item) {
                                        $('#emissionDropdown').append($('<option>', {
                                            value: item,
                                            text: item
                                        }));
                                    });

                                    // 触发emissionDropdown的change事件，以便执行之后的逻辑
                                    $('#emissionDropdown').trigger('change');
                                },
                                error: function (error) {
                                    console.log(error);
                                }
                            });
                        });

                        // 处理emissionDropdown的变化
                        $('#emissionDropdown').change(function () {
                            var selectedValue = $(this).val();

                            $.ajax({
                                url: '/Devices/GetMaterialsAndGWPNames',
                                type: 'GET',
                                data: { emissionPattern: selectedValue },
                                success: function (data) {
                                    // 清空MaterialDropdown的选项
                                    $('#MaterialDropdown').empty();

                                    // 添加新的Material选项
                                    $.each(data.materials, function (i, item) {
                                        $('#MaterialDropdown').append($('<option>', {
                                            value: item.name,
                                            text: item.name
                                        }));
                                    });

                                    // 添加新的GWPNames选项
                                    $.each(data.gwpNames, function (i, item) {
                                        $('#MaterialDropdown').append($('<option>', {
                                            value: item.name,
                                            text: item.name
                                        }));
                                    });
                                },
                                error: function (error) {
                                    console.log(error);
                                }
                            });
                        });
                        $('#nameDropdown').change(function () {
                            // 如果選擇了"其他"
                            if ($(this).val() === '其他') {
                                // 顯示隱藏的輸入欄位
                                $('#OtherName').show();
                            } else {
                                // 否則隱藏輸入欄位
                                $('#OtherName').hide();
                            }
                        });

                        // 攔截表單提交事件
                        $('form').submit(function () {
                            // 如果 nameDropdown 的值是 "其他"
                            if ($('#nameDropdown').val() === '其他') {
                                // 將 OtherName 的值設置為 nameDropdown 的值
                                $('#nameDropdown').val($('#OtherName').val());
                            }
                            // 繼續提交表單
                            return true;
                        });
                    });
                </script>
            }
            <div class="form-group">
                <input type="submit" value="新增" class="btn btn-primary" asp-controller="Devices" asp-action="Create" />
                <a class="btn btn-secondary" asp-controller="Devices" asp-action="Index" asp-route-id="@TempData.Peek("SelectedAreaId")">返回</a>
            </div>
        </form>
    </div>
</div>

