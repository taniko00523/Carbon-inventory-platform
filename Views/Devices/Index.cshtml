@model IEnumerable<Carbon_inventory_platform.Models.Device>

@{
    ViewData["Title"] = "設備資料維護";
}

<h1>設備資料維護</h1>

<p>
    <a class="btn btn-primary"  asp-action="Create">新增設備</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                所在廠區
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AssetNo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Provess)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CO2)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CH4)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.N2O)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HFCS)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PFCS)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SF6)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NF3)
            </th> 
            <th>
                使用物料
            </th>
            <th>
                活動數據
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.AreaId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AssetNo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Provess)
            </td>
            <td>
                    @if (item.CO2 == true)
                    {
                        <p>Y</p>
                    }
            </td>
            <td>
                    @if (item.CH4 == true)
                    {
                        <p>Y</p>
                    }
            </td>
            <td>
                    @if (item.N2O == true)
                    {
                        <p>Y</p>
                    }
            </td>
            <td>
                    @if (item.HFCS == true)
                    {
                        <p>Y</p>
                    }
            </td>
            <td>
                    @if (item.PFCS == true)
                    {
                        <p>Y</p>
                    }
            </td>
            <td>
                    @if (item.SF6 == true)
                    {
                        <p>Y</p>
                    }
            </td>
            <td>
                    @if (item.NF3 == true)
                    {
                        <p>Y</p>
                    }
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Material.Name)
            </td>
            <td>
                    @if (item.ActivityData != null)
                    {
                        <p>@item.ActivityData.Num @item.ActivityData.Unit</p>
                    }
                    else
                    {
                        <p>未填寫</p>
                    }
            </td>
            <td>
                    <a class="btn btn-primary" asp-action="AddActivityData" asp-route-id="@item.Id">新增活動數據</a> |
                    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.Id">修改</a> |
                    <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.Id">刪除</a>
            </td>
        </tr>
}
    </tbody>
</table>






