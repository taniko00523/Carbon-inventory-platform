@model Carbon_inventory_platform.Models.Company

@{
    ViewData["Title"] = "公司資料維護";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="UserId" />
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" placeholder="請填寫公司名稱" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group" style="display:none">
                <label asp-for="EasyName" class="control-label"></label>
                <input asp-for="EasyName"  class="form-control" />
                <span asp-validation-for="EasyName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EnglishName" class="control-label"></label>
                <input asp-for="EnglishName" placeholder="請填寫公司英文名稱" class="form-control" />
                <span asp-validation-for="EnglishName" class="text-danger"></span>
            </div>
            <div class="form-group" style="display:none">
                <label asp-for="EasyEnglishName" class="control-label"></label>
                <input asp-for="EasyEnglishName" class="form-control" />
                <span asp-validation-for="EasyEnglishName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ReportOpening" class="control-label"></label>
                <textarea asp-for="ReportOpening" placeholder="請填寫前言" class="form-control" rows="6"></textarea>
                <span asp-validation-for="ReportOpening" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CompanyInformation" class="control-label"></label>
                <textarea asp-for="CompanyInformation" placeholder="請填寫公司簡介" class="form-control" rows="6"></textarea>
                <span asp-validation-for="CompanyInformation" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ReportingPurposes" class="control-label"></label>
                <textarea asp-for="ReportingPurposes" placeholder="請填寫預期用途" class="form-control" rows="6"></textarea>
                <span asp-validation-for="ReportingPurposes" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AddressInformation" class="control-label"></label>
                <textarea asp-for="AddressInformation" placeholder="本次組織邊界之設定，乃參考ISO/CNS 14064-1與環保署溫室氣體盤查指引..." class="form-control" rows="6"></textarea>
                <span asp-validation-for="AddressInformation" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ReportingInformation" class="control-label"></label>
                <textarea asp-for="ReportingInformation" placeholder="本公司之營運邊界包含直接(類別1)、能源間接(類別2) …….。" class="form-control" rows="6"></textarea>
                <span asp-validation-for="ReportingInformation" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="GHGInformation" class="control-label"></label>
                <textarea asp-for="GHGInformation" placeholder="請填寫溫室氣體排放類型與排放量說明" class="form-control" rows="6"></textarea>
                <span asp-validation-for="GHGInformation" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Scope1Information" class="control-label"></label>
                <textarea asp-for="Scope1Information" placeholder="請填寫直接溫室氣體排放說明" class="form-control" rows="6"></textarea>
                <span asp-validation-for="Scope1Information" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Scope2Information" class="control-label"></label>
                <textarea asp-for="Scope2Information" placeholder="請填寫能源間接溫室氣體排放說明" class="form-control" rows="6"></textarea>
                <span asp-validation-for="Scope2Information" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ContactName" class="control-label"></label>
                <input asp-for="ContactName" placeholder="請填寫聯絡人名稱" class="form-control" />
                <span asp-validation-for="ContactName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" placeholder="請填寫聯絡人Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Phone" class="control-label"></label>
                <input asp-for="Phone" placeholder="請填寫聯絡人手機號碼" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="儲存" class="btn btn-primary" />|
                <a class="btn btn-secondary" asp-controller="Companies" asp-action="Index">返回</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
