@model IEnumerable<Carbon_inventory_platform.Models.Company>
@{
    ViewData["Title"] = "公司總覽";
}
<div class="row">
    <div class="col">
        <h1>@ViewData["Title"] </h1>
    </div>
    <div class="col-2"></div>
    <div class="col">
        @* <form class="d-flex">
        <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search">
        <button class="btn btn-outline-success" type="submit">Search</button>
        </form> *@
    </div>
   @*  <p>
        <a class="btn btn-dark" asp-controller="Companies" asp-action="Create">新增公司</a>
    </p> *@
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EnglishName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ContactName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Phone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReportOpening)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CompanyInformation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReportingPurposes)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AddressInformation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReportingInformation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GHGInformation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Scope1Information)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Scope2Information)
            </th>
            <th></th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EnglishName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ContactName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Phone)
                </td>
                <th>
                    @if (item.CompanyInformation != null)
                    {
                        <p>已填寫</p>
                    }
                    else
                    {
                        <p>未填寫</p>
                    }
                </th>
                <th>
                    @if (item.ReportOpening != null)
                    {
                        <p>已填寫</p>
                    }
                    else
                    {
                        <p>未填寫</p>
                    }
                </th>

                <th>
                    @if (item.ReportingPurposes != null)
                    {
                        <p>已填寫</p>
                    }
                    else
                    {
                        <p>未填寫</p>
                    }
                </th>
                <th>
                    @if (item.AddressInformation != null)
                    {
                        <p>已填寫</p>
                    }
                    else
                    {
                        <p>未填寫</p>
                    }
                </th>
                <th>
                    @if (item.ReportingInformation != null)
                    {
                        <p>已填寫</p>
                    }
                    else
                    {
                        <p>未填寫</p>
                    }
                </th>
                <th>
                    @if (item.GHGInformation != null)
                    {
                        <p>已填寫</p>
                    }
                    else
                    {
                        <p>未填寫</p>
                    }
                </th>
                <th>
                    @if (item.Scope1Information != null)
                    {
                        <p>已填寫</p>
                    }
                    else
                    {
                        <p>未填寫</p>
                    }
                </th>
                <th>
                    @if (item.Scope2Information != null)
                    {
                        <p>已填寫</p>
                    }
                    else
                    {
                        <p>未填寫</p>
                    }
                </th>
                <td>
                    @if (item.ModifiedTime != null)
                    {
                        <a class="btn btn-success" asp-action="Edit" asp-route-id="@item.Id">修改</a>
                    }
                    else
                    {
                        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.Id">填寫</a>
                    }
                    <a class="btn btn-info" asp-area="" asp-controller="Areas" asp-action="AdminIndex" asp-route-id="@item.Id">邊界資料</a>
                </td>
                @* <td>
                    <form method="post" asp-controller="Companies" asp-action="Delete" asp-route-id="@item.Id" onsubmit="return confirm('確定要刪除嗎？');">
                        <button type="submit" class="btn btn-danger">刪除</button>
                    </form>
                </td> *@
            </tr>
        }
    </tbody>
</table>
