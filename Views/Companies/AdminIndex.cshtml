@model IEnumerable<Carbon_inventory_platform.ViewModel.CompanyUserViewModel>
@{
    ViewData["Title"] = "公司總覽";
}
<style>
   /*  th {
        max-width: 100px; 
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    } */
</style>

<div class="row">
    <div class="col">
        <h1>@ViewData["Title"] </h1>
    </div>

</div>

<table class="table table-striped">
    <thead>
        <tr >
            <th>
                使用者名稱
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company.Name)
            </th>
            <th style="width:5%">
                @Html.DisplayNameFor(model => model.Company.EnglishName)
            </th>
            <th style="width:3%">
                @Html.DisplayNameFor(model => model.Company.ContactName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company.Phone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company.CompanyInformation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company.ReportOpening)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company.ReportingPurposes)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company.AddressInformation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company.ReportingInformation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company.GHGInformation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company.Scope1Information)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company.Scope2Information)
            </th>
            <th></th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.ApplicationUser.UserName)
                </td>
                @if (item.Company != null)
                {
                    <td>
                        @Html.DisplayFor(modelItem => item.Company.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Company.EnglishName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Company.ContactName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Company.Email)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Company.Phone)
                    </td>
                    <th>
                        @if (item.Company.CompanyInformation != null)
                        {
                            <p>V</p>
                        }
                        else
                        {
                            <p></p>
                        }
                    </th>
                    <th>
                        @if (item.Company.ReportOpening != null)
                        {
                            <p>V</p>
                        }
                        else
                        {
                            <p></p>
                        }
                    </th>

                    <th>
                        @if (item.Company.ReportingPurposes != null)
                        {
                            <p>V</p>
                        }
                        else
                        {
                            <p></p>
                        }
                    </th>
                    <th>
                        @if (item.Company.AddressInformation != null)
                        {
                            <p>V</p>
                        }
                        else
                        {
                            <p></p>
                        }
                    </th>
                    <th>
                        @if (item.Company.ReportingInformation != null)
                        {
                            <p>V</p>
                        }
                        else
                        {
                            <p></p>
                        }
                    </th>
                    <th>
                        @if (item.Company.GHGInformation != null)
                        {
                            <p>V</p>
                        }
                        else
                        {
                            <p></p>
                        }
                    </th>
                    <th>
                        @if (item.Company.Scope1Information != null)
                        {
                            <p>V</p>
                        }
                        else
                        {
                            <p></p>
                        }
                    </th>
                    <th>
                        @if (item.Company.Scope2Information != null)
                        {
                            <p>V</p>
                        }
                        else
                        {
                            <p></p>
                        }
                    </th>
                    <td>
                        @if (item.Company.ModifiedTime != null)
                        {
                            <a class="btn btn-success" asp-action="Edit" asp-route-id="@item.Company.Id">修改</a>
                        }
                        else
                        {
                            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.Company.Id">填寫</a>
                        }
                    </td>
                    <td>

                        <a class="btn btn-info" asp-area="" asp-controller="Areas" asp-action="AdminIndex" asp-route-id="@item.Company.Id">邊界資料</a>
                    </td>
                }
                else
                {
                    <td colspan="15">尚未創建公司資料</td>
                }

            </tr>
        }
    </tbody>
</table>
