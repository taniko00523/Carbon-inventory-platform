@model IEnumerable<Carbon_inventory_platform.ViewModel.CompanyUserViewModel>
@{
    ViewData["Title"] = "公司總覽";
}
<style>
    /*  th {
                max-width: 100px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            } */
</style>

<div class="d-flex justify-content-between align-items-center">
    <h1>@ViewData["Title"]</h1>
    <!-- 搜尋表單 -->
    <form asp-action="Index" method="get" class="d-flex align-items-center">
        <label for="SearchTerm" class="sr-only">搜尋公司名稱：</label>
        <input type="text" name="searchTerm" value="@ViewData["SearchTerm"]" class="form-control mr-2" placeholder="搜尋公司名稱" />
        <button type="submit" class="btn btn-primary">搜尋</button>
    </form>
</div>

<div class="table-computer-w1024">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>使用者名稱</th>
                <th>@Html.DisplayNameFor(model => model.Company.Name)</th>
                <th style="width:5%">@Html.DisplayNameFor(model => model.Company.EnglishName)</th>
                <th style="width:3%">@Html.DisplayNameFor(model => model.Company.ContactName)</th>
                <th>@Html.DisplayNameFor(model => model.Company.Email)</th>
                <th>@Html.DisplayNameFor(model => model.Company.Phone)</th>
                <th>@Html.DisplayNameFor(model => model.Company.CompanyInformation)</th>
                <th>@Html.DisplayNameFor(model => model.Company.ReportOpening)</th>
                <th>@Html.DisplayNameFor(model => model.Company.ReportingPurposes)</th>
                <th>@Html.DisplayNameFor(model => model.Company.AddressInformation)</th>
                <th>@Html.DisplayNameFor(model => model.Company.ReportingInformation)</th>
                <th>@Html.DisplayNameFor(model => model.Company.GHGInformation)</th>
                <th>@Html.DisplayNameFor(model => model.Company.Scope1Information)</th>
                <th>@Html.DisplayNameFor(model => model.Company.Scope2Information)</th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.ApplicationUser.UserName)</td>
                    @if (item.Company != null)
                    {
                        <td>@Html.DisplayFor(modelItem => item.Company.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.Company.EnglishName)</td>
                        <td>@Html.DisplayFor(modelItem => item.Company.ContactName)</td>
                        <td>@Html.DisplayFor(modelItem => item.Company.Email)</td>
                        <td>@Html.DisplayFor(modelItem => item.Company.Phone)</td>
                        <td>
                            @if (item.Company.CompanyInformation != null)
                            {
                                <p>V</p>
                            }
                            else
                            {
                                <p></p>
                            }
                        </td>
                        <td>
                            @if (item.Company.ReportOpening != null)
                            {
                                <p>V</p>
                            }
                            else
                            {
                                <p></p>
                            }
                        </td>
                        <td>
                            @if (item.Company.ReportingPurposes != null)
                            {
                                <p>V</p>
                            }
                            else
                            {
                                <p></p>
                            }
                        </td>
                        <td>
                            @if (item.Company.AddressInformation != null)
                            {
                                <p>V</p>
                            }
                            else
                            {
                                <p></p>
                            }
                        </td>
                        <td>
                            @if (item.Company.ReportingInformation != null)
                            {
                                <p>V</p>
                            }
                            else
                            {
                                <p></p>
                            }
                        </td>
                        <td>
                            @if (item.Company.GHGInformation != null)
                            {
                                <p>V</p>
                            }
                            else
                            {
                                <p></p>
                            }
                        </td>
                        <td>
                            @if (item.Company.Scope1Information != null)
                            {
                                <p>V</p>
                            }
                            else
                            {
                                <p></p>
                            }
                        </td>
                        <td>
                            @if (item.Company.Scope2Information != null)
                            {
                                <p>V</p>
                            }
                            else
                            {
                                <p></p>
                            }
                        </td>
                        <td>
                            @if (item.Company.ModifiedTime != null)
                            {
                                <a class="btn btn-success" asp-action="Edit" asp-route-id="@item.Company.Id">修改</a>
                            }
                            else
                            {
                                <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.Company.Id">填寫</a>
                            }
                        </td>
                        <td>
                            <a class="btn btn-info" asp-area="" asp-controller="Areas" asp-action="Index" asp-route-id="@item.Company.Id">邊界資料</a>
                        </td>
                    }
                    else
                    {
                        <td colspan="15">尚未創建公司資料</td>
                    }
                </tr>
            }
        </tbody>
    </table>

</div>
<div class="table-phone-w1024">
    @foreach (var item in Model)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">@Html.DisplayFor(modelItem => item.ApplicationUser.UserName)</h5>
                @if (item.Company != null)
                {
                    <p class="card-text"><strong>@Html.DisplayNameFor(model => model.Company.Name):</strong> @Html.DisplayFor(modelItem => item.Company.Name)</p>
                    <p class="card-text"><strong>@Html.DisplayNameFor(model => model.Company.EnglishName):</strong> @Html.DisplayFor(modelItem => item.Company.EnglishName)</p>
                    <p class="card-text"><strong>@Html.DisplayNameFor(model => model.Company.ContactName):</strong> @Html.DisplayFor(modelItem => item.Company.ContactName)</p>
                    <p class="card-text"><strong>@Html.DisplayNameFor(model => model.Company.Email):</strong> @Html.DisplayFor(modelItem => item.Company.Email)</p>
                    <p class="card-text"><strong>@Html.DisplayNameFor(model => model.Company.Phone):</strong> @Html.DisplayFor(modelItem => item.Company.Phone)</p>
                    <p class="card-text"><strong>@Html.DisplayNameFor(model => model.Company.CompanyInformation):</strong> @(item.Company.CompanyInformation != null ? "已填寫" : "")</p>
                    <p class="card-text"><strong>@Html.DisplayNameFor(model => model.Company.ReportOpening):</strong> @(item.Company.ReportOpening != null ? "已填寫" : "")</p>
                    <p class="card-text"><strong>@Html.DisplayNameFor(model => model.Company.ReportingPurposes):</strong> @(item.Company.ReportingPurposes != null ? "已填寫" : "")</p>
                    <p class="card-text"><strong>@Html.DisplayNameFor(model => model.Company.AddressInformation):</strong> @(item.Company.AddressInformation != null ? "已填寫" : "")</p>
                    <p class="card-text"><strong>@Html.DisplayNameFor(model => model.Company.ReportingInformation):</strong> @(item.Company.ReportingInformation != null ? "已填寫" : "")</p>
                    <p class="card-text"><strong>@Html.DisplayNameFor(model => model.Company.GHGInformation):</strong> @(item.Company.GHGInformation != null ? "已填寫" : "")</p>
                    <p class="card-text"><strong>@Html.DisplayNameFor(model => model.Company.Scope1Information):</strong> @(item.Company.Scope1Information != null ? "已填寫" : "")</p>
                    <p class="card-text"><strong>@Html.DisplayNameFor(model => model.Company.Scope2Information):</strong> @(item.Company.Scope2Information != null ? "已填寫" : "")</p>
                    <a class="btn btn-success" asp-action="Edit" asp-route-id="@item.Company.Id">@((item.Company.ModifiedTime != null) ? "修改" : "填寫")</a>
                    <a class="btn btn-info" asp-area="" asp-controller="Areas" asp-action="Index" asp-route-id="@item.Company.Id">邊界資料</a>
                }
                else
                {
                    <p class="card-text">尚未創建公司資料</p>
                }
            </div>
        </div>
    }
</div>

<!-- 分頁控制 -->
@if (ViewData["TotalPages"] != null)
{
    int totalPages = (int)ViewData["TotalPages"];
    int currentPage = (int)ViewData["PageNumber"];

    <nav aria-label="Page navigation">
        <ul class="pagination">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" href="?searchTerm=@ViewData["SearchTerm"]&pageNumber=@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}