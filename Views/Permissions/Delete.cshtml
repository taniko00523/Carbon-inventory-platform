@model Carbon_inventory_platform.Models.Permission

@{
    ViewData["Title"] = "刪除權限";
}

<h1>刪除權限</h1>

<h3>確定要刪除這筆資料嗎？</h3>
<div>
    <h4>權限</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IsDeleted)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IsDeleted)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CreateTime)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CreateTime)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ModifyTime)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ModifyTime)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DeleteTime)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DeleteTime)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Function)
        </dt>
        <dd class = "col-sm-10">
            @Model?.Function?.CName
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FunctionAction)
        </dt>
        <dd class = "col-sm-10">
            @Model?.FunctionAction?.CName
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="刪除" class="btn btn-danger" /> |
        <a asp-action="Index">回列表</a>
    </form>
</div>
