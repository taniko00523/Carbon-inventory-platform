@model Carbon_inventory_platform.Models.DeviceData

@{
    ViewData["Title"] = "排放源設定詳細資料";

    static string DataCorrectionText(int grade) => grade switch
    {
        1 => "連續監測",
        2 => "定期/間歇量測",
        3 => "自行/財務推估",
        _ => grade.ToString(),
    };

    static string DeviceCorrectionText(int grade) => grade switch
    {
        1 => "有外部校正或多組數據佐證者",
        2 => "有內部校正或經過會計簽證等證明者",
        3 => "未進行儀器校正或未進行紀錄彙整者",
        _ => grade.ToString(),
    };

    static string GradeBadgeClass(int grade) => grade switch
    {
        1 => "cip-badge-success",
        2 => "cip-badge-warning",
        _ => "cip-badge-danger",
    };
}

<div class="cip-page-head">
    <div>
        <h1>@ViewData["Title"]</h1>
    </div>
    <div class="cip-page-actions">
        <a class="btn btn-success" asp-action="Edit" asp-route-id="@Model?.Id">編輯</a>
        <a class="btn btn-outline-secondary" asp-action="Index">返回</a>
    </div>
</div>

<section class="cip-section">
    <dl class="row mb-0">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Name)</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Scope)</dt>
        <dd class="col-sm-9"><span class="cip-badge cip-badge-neutral">@Model?.Scope</span></dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.EmissionPattern)</dt>
        <dd class="col-sm-9"><span class="cip-badge cip-badge-neutral">@Model?.EmissionPattern</span></dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Material)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Material)</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Data_Correction)</dt>
        <dd class="col-sm-9"><span class="cip-badge @GradeBadgeClass(Model!.Data_Correction)">@DataCorrectionText(Model.Data_Correction)</span></dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Device_Correction)</dt>
        <dd class="col-sm-9"><span class="cip-badge @GradeBadgeClass(Model.Device_Correction)">@DeviceCorrectionText(Model.Device_Correction)</span></dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.unit)</dt>
        <dd class="col-sm-9 mb-0">@Html.DisplayFor(model => model.unit)</dd>
    </dl>
</section>
