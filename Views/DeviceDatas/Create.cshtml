@model Carbon_inventory_platform.Models.DeviceData

@{
    ViewData["Title"] = "新增排放源設定";
}

<div class="cip-page-head">
    <div>
        <h1>@ViewData["Title"]</h1>
    </div>
    <div class="cip-page-actions">
        <a class="btn btn-outline-secondary" asp-action="Index">返回</a>
    </div>
</div>

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <section class="cip-section">
        <div class="form-group">
            <label asp-for="Name" class="control-label cip-required"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="cip-form-grid">
            <div class="form-group">
                <label asp-for="Scope" class="control-label cip-required"></label>
                <select asp-for="Scope" class="form-control" asp-items="ViewBag.ScopeList">
                    <option value="" disabled selected>請選擇類別</option>
                </select>
                <span asp-validation-for="Scope" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EmissionPattern" class="control-label cip-required"></label>
                <select asp-for="EmissionPattern" class="form-control" asp-items="ViewBag.EmissionPatternList">
                    <option value="" disabled selected>請選擇排放型式</option>
                </select>
                <span asp-validation-for="EmissionPattern" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group">
            <label asp-for="Material" class="control-label cip-required"></label>
            <select asp-for="Material" class="form-control" asp-items="ViewBag.MaterialList">
                <option value="" disabled selected>請選擇原燃物料</option>
            </select>
            <span asp-validation-for="Material" class="text-danger"></span>
        </div>
        <div class="cip-form-grid">
            <div class="form-group">
                <label asp-for="Data_Correction" class="control-label cip-required"></label>
                <select asp-for="Data_Correction" class="form-control" asp-items="ViewBag.DataCorrectionList"></select>
                <span asp-validation-for="Data_Correction" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Device_Correction" class="control-label cip-required"></label>
                <select asp-for="Device_Correction" class="form-control" asp-items="ViewBag.DeviceCorrectionList"></select>
                <span asp-validation-for="Device_Correction" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group">
            <label asp-for="unit" class="control-label cip-required"></label>
            <input asp-for="unit" class="form-control" />
            <span asp-validation-for="unit" class="text-danger"></span>
        </div>
    </section>

    <div class="cip-form-actions">
        <button type="submit" class="btn btn-primary">新增</button>
        <a class="btn btn-outline-secondary" asp-action="Index">取消</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
