@model Carbon_inventory_platform.Models.DefaultDevices

@{
    ViewData["Title"] = "編輯預設排放源";
}

<div class="cip-page-head">
    <div>
        <h1>@ViewData["Title"]</h1>
    </div>
    <div class="cip-page-actions">
        <a class="btn btn-outline-secondary" asp-action="Index">返回</a>
    </div>
</div>

<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <section class="cip-section">
        <div class="form-group">
            <label asp-for="Name" class="control-label cip-required"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="cip-form-grid">
            <div class="form-group">
                <label asp-for="Scope" class="control-label cip-required"></label>
                <select asp-for="Scope" class="form-control" asp-items="ViewBag.ScopeList"></select>
                <span asp-validation-for="Scope" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EmissionPattern" class="control-label cip-required"></label>
                <select asp-for="EmissionPattern" class="form-control" asp-items="ViewBag.EmissionPatternList"></select>
                <span asp-validation-for="EmissionPattern" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group">
            <label asp-for="Material" class="control-label cip-required"></label>
            <select asp-for="Material" class="form-control" asp-items="ViewBag.MaterialList"></select>
            <span asp-validation-for="Material" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Type" class="control-label cip-required"></label>
            <input asp-for="Type" class="form-control" />
            <span asp-validation-for="Type" class="text-danger"></span>
        </div>
    </section>

    <div class="cip-form-actions">
        <button type="submit" class="btn btn-primary">儲存</button>
        <a class="btn btn-outline-secondary" asp-action="Index">取消</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
