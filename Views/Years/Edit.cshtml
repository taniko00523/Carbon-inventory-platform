@model Carbon_inventory_platform.Models.Year

@{
    ViewData["Title"] = "Edit";
}

<h1>修改</h1>

<h4>盤查年度</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Company" />
            <input type="hidden" asp-for="Area" />
            <div class="form-group">
                <label asp-for="Num" class="control-label"></label>
                <input asp-for="Num" placeholder="請填寫民國盤查年度" class="form-control" />
                <span asp-validation-for="Num" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="確認" class="btn btn-primary" />
                <a class="btn btn-secondary" asp-controller="Years" asp-action="Index" asp-route-id="@TempData.Peek("areaId")">返回</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
