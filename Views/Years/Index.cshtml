@model IEnumerable<Carbon_inventory_platform.Models.Year>

<div class="row">
    <div class="col">
        <h1>盤查年設定</h1>
        @if (@TempData.Peek("areaName") != null)
        {
            <h3>@TempData.Peek("companyName")-@TempData.Peek("areaName")</h3>
        }
        else
        {
            <h3>@TempData.Peek("companyName")</h3>
        }

        <form method="post" asp-action="Create">
            <input placeholder="請輸入民國年" type="number" name="Year" required>
            <button class="btn btn-primary" type="submit">新增</button>
        </form>

        <a class="btn btn-secondary" asp-controller="Areas" asp-action="Index" asp-route-id=@TempData.Peek("companyId")>返回</a>
    </div>
</div>
<div asp-validation-summary="All" class="text-danger"></div>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Num)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.All)
            </th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Num)
                </td>
                <th>
                    @Html.DisplayFor(modelItem => item.All)
                </th>
                <td>
                    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.Id">修改</a>
                    <a class="btn btn-info" asp-controller="Devices" asp-action="Index" asp-route-id="@item.Id" >排放源資料</a>
                    <a asp-controller="Emission" asp-action="Index" asp-route-id="@item.Id"
                       class="btn @((bool)TempData.Peek("NoActivityData") ? "btn-danger disabled" : "btn-primary")">
                        總排放量
                    </a>
                    <a class="btn btn-dark" asp-controller="Emission" asp-action="Word" asp-route-id="@TempData.Peek("SelectedAreaId")" asp-route-year="@TempData.Peek("yearSelected")">報告書下載</a>
                </td>
                <td>
                    <form method="post" asp-controller="Years" asp-action="Delete" asp-route-id="@item.Id" onsubmit="return confirm('確定要刪除嗎？');">
                        <button type="submit" class="btn btn-danger">刪除</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
