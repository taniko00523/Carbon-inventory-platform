@model IEnumerable<Carbon_inventory_platform.Models.Area>

@{
    ViewData["Title"] = "公司資料維護";
}

<div class="row">
    <div class="col">
        <h1>公司資料維護</h1>
    </div>
    <div class="col-6"></div>
    <div class="col">
        <form class="d-flex">
            <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search">
            <button class="btn btn-outline-success" type="submit">Search</button>
        </form>
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company.Name)
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Company.Name)
            </td>
            <td>
                <a class="btn btn-primary" asp-controller="Device" asp-action="Index" asp-route-id="@item.Id">檢視</a> 
            </td>
        </tr>
}
    </tbody>
</table>
