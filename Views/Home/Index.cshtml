@model IEnumerable<Carbon_inventory_platform.Models.Area>

@{
    ViewData["Title"] = "輔導廠商";
}

<div class="row">
    <div class="col">
        <h1>輔導廠商</h1>
    </div>
    <div class="col-6"></div>
    <div class="col">
        <form class="d-flex">
            <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search">
            <button class="btn btn-outline-success" type="submit">Search</button>
        </form>
    </div>
    <p>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Default">新增預設設定</a>
    </p>
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Company.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Company.Name)
                    <a class="btn btn-primary" asp-controller="Companies" asp-action="Edit" asp-route-id="@item.CompanyId">公司資料設定</a>
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                    <a class="btn btn-primary" asp-controller="Areas" asp-action="Edit" asp-route-id="@item.Id">邊界資料設定</a>
                </td>
                <td>
                    <a class="btn btn-primary" asp-controller="Devices" asp-action="Index" asp-route-id="@item.Id">排放源設定</a>
                    <a class="btn btn-primary" asp-controller="Emission" asp-action="Index" asp-route-id="@item.Id">總排放量</a>
                    <a class="btn btn-primary" asp-controller="Home" asp-action="Word" asp-route-id="@item.Id">報告書產生</a>
                </td>
            </tr>
        }
    </tbody>
</table>
