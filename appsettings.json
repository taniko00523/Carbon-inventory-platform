{
  // 連線字串請勿寫在原始碼中。正式環境請改用下列任一方式提供：
  //   1. 環境變數      ConnectionStrings__DefaultConnection
  //   2. Azure App Service 的「連線字串」設定
  //   3. 本機開發      dotnet user-secrets set "ConnectionStrings:DefaultConnection" "..."
  // 原本這裡直接寫著 Azure SQL 的帳號密碼並且已經進入 git 歷史，該組帳密必須輪替。
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Identity": {
    "Password": {
      // 密碼長度下限。原本設為 1，任何帳號都能被瞬間猜中。
      "RequiredLength": 8
    }
  },
  "Line": {
    // 回報問題通知用的 LINE Messaging API 設定。
    // 原本 Channel Access Token 直接寫在 FeedbacksController.cs 裡並已進入 git 歷史，
    // 該 Token 必須到 LINE Developers Console 重新發行。
    // 留空則不發送通知（功能會安靜地停用，不會讓回報失敗）。
    "ChannelAccessToken": "",
    "NotifyUserId": ""
  },
  "ApplicationInsights": {
    // 連線字串留空則 SDK 安靜地不送遙測，不影響啟動。
    // 正式環境請用 dotnet user-secrets 或環境變數 ApplicationInsights__ConnectionString 提供。
    "ConnectionString": ""
  },
  "Email": {
    // 忘記密碼／帳號通知信用的 SMTP 設定。Host 留空則不會寄信（安靜地停用，不影響其他功能）。
    // 正式環境的帳號密碼請用 dotnet user-secrets 或環境變數 Email__UserName / Email__Password 提供。
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "UserName": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "碳盤查平台"
  },
  "Seed": {
    // 首次啟動時建立的管理員帳號。未設定密碼就不會建立帳號。
    "AdminUserName": "Admin",
    "AdminPassword": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
